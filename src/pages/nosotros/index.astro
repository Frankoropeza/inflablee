---
import { getCollection, render } from "astro:content";
import PageLayout from "@/layouts/PageLayout.astro";
import PageHero from "@/components/PageHero.astro";
import LeadCapture from "@/components/LeadCapture.astro";
const pagina = (await getCollection("paginas")).find((entry) => entry.id === "nosotros");
if (!pagina) throw new Error("Falta el contenido de nosotros.");
const { Content } = await render(pagina);
---

<PageLayout title={pagina.data.title} description={pagina.data.description} breadcrumbs={[{ name: "Inicio", href: "/" }, { name: "Nosotros" }]}>
  <main id="contenido-principal">
    <PageHero eyebrow="Sobre nosotros" title="Diversión segura para cada evento" desc="En INFLABLEE nos dedicamos a llevar alegría y entretenimiento a fiestas infantiles, eventos corporativos y celebraciones de todo tipo en México." />
    <section style="padding:var(--spacing-4xl) 0;"><div class="container legal" style="max-width:800px;"><Content /></div></section>
    <LeadCapture />
  </main>
</PageLayout>
