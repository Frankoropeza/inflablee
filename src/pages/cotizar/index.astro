---
import PageLayout from "@/layouts/PageLayout.astro";
import PageHero from "@/components/PageHero.astro";
import CTABanner from "@/components/CTABanner.astro";
import { SITE } from "@/data/site";
---

<PageLayout
  title="Cotizar Renta de Inflables — Formulario Rápido | INFLABLEE"
  description="Cotiza la renta de inflables para tu evento en CDMX y Estado de México. Respuesta en menos de 2 horas. Sin compromiso, sin costos ocultos."
  breadcrumbs={[{ name: "Inicio", href: "/" }, { name: "Cotizar" }]}
>
  <main id="contenido-principal">
    <PageHero
      eyebrow="Cotización rápida"
      title="Cotiza tu evento\nen <span>minutos</span>"
      desc="Llena el formulario y recibe tu cotización personalizada por WhatsApp en menos de 2 horas. Sin compromiso, sin costos ocultos."
      ctas={[
        { href: "#formulario", label: "Ir al formulario", variant: "primary" },
        { href: `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent("Hola INFLABLEE, quiero una cotización rápida.")}`, label: "Directo por WhatsApp", variant: "outline" },
      ]}
    />

    <section class="cotizar-form-section" id="formulario">
      <div class="container">
        <div class="cotizar-layout">
          <div class="cotizar-form-wrap">
            <h2 class="cotizar-form-wrap__title">📋 Datos de tu evento</h2>
            <form class="cotizar-form" id="cotizar-form">
              <!-- Paso 1: Datos personales -->
              <div class="cotizar-form__group">
                <label class="cotizar-form__label" for="nombre">Tu nombre *</label>
                <input class="cotizar-form__input" type="text" id="nombre" placeholder="Ej: Laura Martínez" required />
              </div>

              <div class="cotizar-form__row">
                <div class="cotizar-form__group">
                  <label class="cotizar-form__label" for="telefono">Teléfono / WhatsApp *</label>
                  <input class="cotizar-form__input" type="tel" id="telefono" placeholder="55 1234 5678" required />
                </div>
                <div class="cotizar-form__group">
                  <label class="cotizar-form__label" for="email">Correo electrónico</label>
                  <input class="cotizar-form__input" type="email" id="email" placeholder="tu@email.com" />
                </div>
              </div>

              <!-- Paso 2: Evento -->
              <div class="cotizar-form__group">
                <label class="cotizar-form__label" for="tipo-evento">Tipo de evento *</label>
                <select class="cotizar-form__select" id="tipo-evento" required>
                  <option value="">Selecciona...</option>
                  <option value="Cumpleaños infantil">🎂 Cumpleaños infantil</option>
                  <option value="Kermés escolar">🏫 Kermés escolar</option>
                  <option value="Evento corporativo">🏢 Evento corporativo</option>
                  <option value="Posada navideña">🎄 Posada navideña</option>
                  <option value="Quinceañera">💃 Quinceañera</option>
                  <option value="Festival comunitario">🎪 Festival comunitario</option>
                  <option value="Otro">📋 Otro</option>
                </select>
              </div>

              <div class="cotizar-form__row">
                <div class="cotizar-form__group">
                  <label class="cotizar-form__label" for="fecha">Fecha del evento *</label>
                  <input class="cotizar-form__input" type="date" id="fecha" required />
                </div>
                <div class="cotizar-form__group">
                  <label class="cotizar-form__label" for="invitados">Número de niños (aprox.)</label>
                  <select class="cotizar-form__select" id="invitados">
                    <option value="">Selecciona...</option>
                    <option value="Menos de 20">Menos de 20</option>
                    <option value="20-50">20 a 50</option>
                    <option value="50-100">50 a 100</option>
                    <option value="100-200">100 a 200</option>
                    <option value="Más de 200">Más de 200</option>
                  </select>
                </div>
              </div>

              <!-- Paso 3: Inflable -->
              <div class="cotizar-form__group">
                <label class="cotizar-form__label" for="inflable">¿Qué inflable(s) te interesan?</label>
                <select class="cotizar-form__select" id="inflable">
                  <option value="">Selecciona o déjalo en blanco para asesoría</option>
                  <option value="Castillo inflable">🏰 Castillo inflable</option>
                  <option value="Tobogán acuático">🌊 Tobogán acuático</option>
                  <option value="Pista de obstáculos">🏃 Pista de obstáculos</option>
                  <option value="Ring de boxeo">🥊 Ring de boxeo</option>
                  <option value="Toro mecánico">🤠 Toro mecánico</option>
                  <option value="Paquete completo">📦 Paquete completo</option>
                  <option value="No estoy seguro">🤔 No estoy seguro (necesito asesoría)</option>
                </select>
              </div>

              <div class="cotizar-form__group">
                <label class="cotizar-form__label" for="zona">Zona de entrega *</label>
                <select class="cotizar-form__select" id="zona" required>
                  <option value="">Selecciona...</option>
                  <option value="CDMX - Norte">CDMX - Norte</option>
                  <option value="CDMX - Sur">CDMX - Sur</option>
                  <option value="CDMX - Oriente">CDMX - Oriente</option>
                  <option value="CDMX - Poniente">CDMX - Poniente</option>
                  <option value="CDMX - Centro">CDMX - Centro</option>
                  <option value="Edomex - Ecatepec/Neza">Edomex - Ecatepec / Neza</option>
                  <option value="Edomex - Naucalpan/Tlalnepantla">Edomex - Naucalpan / Tlalnepantla</option>
                  <option value="Edomex - Toluca">Edomex - Toluca</option>
                  <option value="Edomex - Otro">Edomex - Otro municipio</option>
                </select>
              </div>

              <div class="cotizar-form__group">
                <label class="cotizar-form__label" for="comentarios">Comentarios adicionales</label>
                <textarea class="cotizar-form__textarea" id="comentarios" rows="3" placeholder="Cuéntanos más sobre tu evento: espacio disponible, temática, presupuesto aproximado..."></textarea>
              </div>

              <button type="submit" class="btn btn--primary btn--full" style="font-size:var(--font-size-base);padding:1rem;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                Enviar cotización por WhatsApp
              </button>
              <p class="cotizar-form__nota">
                Al enviar, se abrirá WhatsApp con tu solicitud ya redactada. Respondemos en menos de 2 horas.
              </p>
            </form>
          </div>

          <aside class="cotizar-sidebar">
            <div class="cotizar-sidebar__card">
              <h3>✅ ¿Qué incluye tu renta?</h3>
              <p>Todas nuestras rentas incluyen sin costo adicional:</p>
              <ul class="cotizar-sidebar__list">
                <li>Entrega y retiro a domicilio</li>
                <li>Instalación profesional</li>
                <li>Soplador eléctrico</li>
                <li>Supervisor capacitado</li>
                <li>Seguro de responsabilidad civil</li>
                <li>Sanitización previa</li>
              </ul>
            </div>

            <div class="cotizar-sidebar__card" style="margin-top:1rem;background:var(--color-secondary);color:white;">
              <h3 style="color:#fff;">💡 Tip para cotizar</h3>
              <p style="color:rgba(255,255,255,0.8);">Si no sabes qué inflable elegir, solo indícanos la edad de los niños, el espacio disponible y tu presupuesto. ¡Te asesoramos gratis!</p>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <CTABanner
      title="¿Prefieres cotizar directamente?"
      subtitle="Escríbenos por WhatsApp y te respondemos de inmediato."
      primaryText="WhatsApp directo"
    />
  </main>
</PageLayout>

<script>
  const form = document.getElementById('cotizar-form') as HTMLFormElement;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const nombre = (document.getElementById('nombre') as HTMLInputElement).value;
    const telefono = (document.getElementById('telefono') as HTMLInputElement).value;
    const tipoEvento = (document.getElementById('tipo-evento') as HTMLSelectElement).value;
    const fecha = (document.getElementById('fecha') as HTMLInputElement).value;
    const invitados = (document.getElementById('invitados') as HTMLSelectElement).value;
    const inflable = (document.getElementById('inflable') as HTMLSelectElement).value;
    const zona = (document.getElementById('zona') as HTMLSelectElement).value;
    const comentarios = (document.getElementById('comentarios') as HTMLTextAreaElement).value;

    let msg = `Hola INFLABLEE, quiero cotizar inflables para mi evento:\n\n`;
    msg += `👤 Nombre: ${nombre}\n`;
    msg += `📱 Tel: ${telefono}\n`;
    msg += `🎉 Evento: ${tipoEvento}\n`;
    msg += `📅 Fecha: ${fecha}\n`;
    if (invitados) msg += `👥 Niños aprox: ${invitados}\n`;
    if (inflable) msg += `🎪 Inflable: ${inflable}\n`;
    msg += `📍 Zona: ${zona}\n`;
    if (comentarios) msg += `\n💬 Comentarios: ${comentarios}`;

    window.open(`https://wa.me/521XXXXXXXXXX?text=${encodeURIComponent(msg)}`, '_blank');
  });
</script>
