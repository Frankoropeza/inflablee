---
import PageLayout from "@/layouts/PageLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import CTABanner from "@/components/CTABanner.astro";
import LeadCapture from "@/components/LeadCapture.astro";
import { SITE } from "@/data/site";

const categorias = [
  "Castillos Inflables",
  "Toboganes Acuáticos",
  "Pistas de Obstáculos",
  "Juegos Interactivos",
  "Fiestas Infantiles",
  "Eventos Escolares",
];

const galeria = [
  // `img` es la foto real del inflable que se usó en ese evento (public/img/inflables/).
  // Los dos marcados con `ilustracion` no son foto de evento: son ilustración de marca
  // (SVG) porque de esos dos juegos todavía no hay fotografía propia.
  { cat: "Fiestas Infantiles", gradient: "linear-gradient(135deg, #FF4B1F22 0%, #FFD70022 100%)", emoji: "🎂", title: "Cumpleaños princesas en Coyoacán", img: "/img/inflables/castillo-princesas/castillo-princesas-renta-cdmx.avif", w: 1200, h: 675 },
  { cat: "Toboganes Acuáticos", gradient: "linear-gradient(135deg, #1A1A2E22 0%, #0077CC22 100%)", emoji: "🌊", title: "Tobogán acuático en Naucalpan", img: "/img/inflables/extremo/extremo-tobogan-doble.avif", w: 1200, h: 675 },
  { cat: "Eventos Escolares", gradient: "linear-gradient(135deg, #16a34a15 0%, #16a34a08 100%)", emoji: "🏫", title: "Kermés escuela primaria Edomex", img: "/img/inflables/gusanitos/gusanitos-brincolin-evento.avif", w: 1200, h: 675 },
  { cat: "Castillos Inflables", gradient: "linear-gradient(135deg, #FF4B1F20 0%, #FFD70015 100%)", emoji: "🏰", title: "Castillo dragón en Iztapalapa", img: "/img/inflables/dragones-rojos/castillo-dragones-renta-cdmx.avif", w: 1200, h: 675 },
  { cat: "Pistas de Obstáculos", gradient: "linear-gradient(135deg, #FF4B1F18 0%, #1A1A2E12 100%)", emoji: "🏃", title: "Pista obstáculos evento corporativo", img: "/img/inflables/extremo/extremo-angulo-corporativo.avif", w: 1200, h: 675 },
  { cat: "Juegos Interactivos", gradient: "linear-gradient(135deg, #FFD70022 0%, #FF4B1F18 100%)", emoji: "🥊", title: "Ring de boxeo en quinceañera", img: "/img/ilustraciones/ring-de-boxeo-inflable.svg", w: 1200, h: 675, ilustracion: true },
  { cat: "Toboganes Acuáticos", gradient: "linear-gradient(135deg, #0077CC20 0%, #1A1A2E15 100%)", emoji: "💦", title: "Doble tobogán fiesta de verano", img: "/img/inflables/pista-extremo/alquiler-inflable-extremo-grande-fiestas.avif", w: 720, h: 480 },
  { cat: "Fiestas Infantiles", gradient: "linear-gradient(135deg, #FF4B1F15 0%, #FFD70022 100%)", emoji: "🎉", title: "Paquete cumpleaños en Benito Juárez", img: "/img/inflables/mini-castillo/mini-castillo-cumpleanos-infantil.avif", w: 1200, h: 675 },
  { cat: "Eventos Escolares", gradient: "linear-gradient(135deg, #16a34a12 0%, #16a34a20 100%)", emoji: "🎓", title: "Festival fin de ciclo escolar", img: "/img/inflables/mini-jungla/mini-jungla-exterior-evento.avif", w: 1200, h: 675 },
  { cat: "Castillos Inflables", gradient: "linear-gradient(135deg, #FFD70018 0%, #FF4B1F20 100%)", emoji: "🏰", title: "Castillo princesas en GAM", img: "/img/inflables/castillo-princesas/mini-castillo-princesas-fiesta.avif", w: 1200, h: 675 },
  { cat: "Juegos Interactivos", gradient: "linear-gradient(135deg, #FF4B1F18 0%, #FFD70015 100%)", emoji: "🤠", title: "Toro mecánico evento empresa", img: "/img/ilustraciones/toro-mecanico-inflable.svg", w: 1200, h: 675, ilustracion: true },
  { cat: "Pistas de Obstáculos", gradient: "linear-gradient(135deg, #1A1A2E18 0%, #FF4B1F15 100%)", emoji: "🎪", title: "Pista obstáculos 15m en kermés", img: "/img/inflables/pista-extremo/alquiler-circuito-obstaculos-inflable-cdmx.avif", w: 720, h: 480 },
];

const slug = (t: string) =>
  t.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
---

<PageLayout
  title="Galería de Eventos con Inflables — Fiestas y Kermeses | INFLABLEE"
  description="Galería de fotos de eventos con inflables INFLABLEE: cumpleaños infantiles, kermeses escolares, eventos corporativos y más en CDMX y Estado de México."
  breadcrumbs={[{ name: "Inicio", href: "/" }, { name: "Galería" }]}
>
  <main id="contenido-principal">
    <PageHero
      eyebrow="Galería de eventos"
      title="Momentos de pura\n<span>diversión inflable</span>"
      desc={`${SITE.trayectoria.eventos} eventos realizados en CDMX y Estado de México entre ${SITE.trayectoria.desde} y ${SITE.trayectoria.hasta}. Mira cómo transformamos cada fiesta en un recuerdo inolvidable.`}
      ctas={[
        { href: `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent("Hola INFLABLEE, vi la galería y quiero cotizar para mi evento.")}`, label: "Quiero esto para mi fiesta", variant: "primary" },
        { href: "/inflables", label: "Ver catálogo", variant: "outline" },
      ]}
      stats={[
        { value: String(SITE.trayectoria.eventos), label: "Eventos realizados" },
        { value: `${SITE.resenas.rating}★`, label: "Calificación promedio" },
        { value: "0", label: "Eventos cancelados" },
      ]}
    />

    <!-- Filtros de categoría -->
    <nav style="background:var(--color-white);border-bottom:2px solid var(--color-border);padding:1rem 0;position:sticky;top:72px;z-index:100;">
      <div class="container">
        <div class="galeria-filtros" role="group" aria-label="Filtrar galería por categoría">
          <button type="button" class="cat-bar__btn cat-bar__btn--active" data-filtro="todos" aria-pressed="true">Todos</button>
          {categorias.map(c => (
            <button type="button" class="cat-bar__btn" data-filtro={slug(c)} aria-pressed="false">{c}</button>
          ))}
        </div>
      </div>
    </nav>

    <!-- Galería grid -->
    <section style="padding:var(--spacing-3xl) 0;background:var(--color-accent);" id="galeria">
      <div class="container">
        <SectionHeader
          title="Nuestros mejores momentos"
          subtitle="Cada foto representa una fiesta exitosa y familias felices."
        />
        <div class="galeria-grid" style="margin-top:var(--spacing-xl);">
          {galeria.map((item, i) => (
            <figure
              class={`galeria-item${i === 0 || i === 7 ? " galeria-item--wide" : ""}${item.ilustracion ? " galeria-item--ilustracion" : ""}`}
              style={`background:${item.gradient};`}
              data-cat={slug(item.cat)}
            >
              {item.img && (
                <img
                  src={item.img}
                  alt={item.ilustracion
                    ? `Ilustración de ${item.title.toLowerCase()} — INFLABLEE`
                    : `${item.title} — renta de inflables INFLABLEE`}
                  width={item.w}
                  height={item.h}
                  loading={i < 3 ? "eager" : "lazy"}
                  decoding="async"
                  class="galeria-item__img"
                />
              )}
              <figcaption class="galeria-item__overlay">
                {!item.img && <span class="galeria-item__emoji">{item.emoji}</span>}
                <div class="galeria-item__info">
                  <span class="galeria-item__cat">
                    {item.cat}{item.ilustracion && " · Ilustración"}
                  </span>
                  <span class="galeria-item__title">{item.title}</span>
                </div>
              </figcaption>
            </figure>
          ))}
        </div>
        <p class="galeria-vacio" hidden>No hay fotos en esta categoría todavía. Escríbenos y te mandamos las del evento que te interese.</p>
      </div>
    </section>

    <!-- CTA social proof -->
    <section style="padding:var(--spacing-3xl) 0;text-align:center;">
      <div class="container" style="max-width:680px;">
        <h2 style="font-size:clamp(1.5rem,3vw,2rem);font-weight:800;color:var(--color-secondary);margin-bottom:1rem;">¿Tu fiesta podría ser la próxima?</h2>
        <p style="color:var(--color-text-light);font-size:var(--font-size-lg);line-height:1.7;margin-bottom:var(--spacing-xl);">
          Únete a las familias y empresas de los {SITE.trayectoria.eventos} eventos que INFLABLEE ya operó en CDMX y Estado de México.
        </p>
        <a href={`https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent("Hola INFLABLEE, vi la galería y quiero cotizar inflables para mi evento.")}`}
          class="btn btn--primary" target="_blank" rel="noopener" style="font-size:var(--font-size-base);padding:1rem 2rem;">
          Cotizar mi evento ahora →
        </a>
      </div>
    </section>

    <CTABanner />
    <LeadCapture />
  </main>
</PageLayout>

<style>
.galeria-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1rem;
}
@media (min-width: 768px) {
  .galeria-grid { grid-template-columns: repeat(3, 1fr); }
}
@media (min-width: 1200px) {
  .galeria-grid { grid-template-columns: repeat(4, 1fr); }
}
.galeria-item {
  position: relative;
  margin: 0;
  border-radius: var(--border-radius-lg);
  overflow: hidden;
  aspect-ratio: 4/3;
  cursor: pointer;
  transition: transform var(--transition-base);
}
.galeria-item:hover { transform: scale(1.02); }
.galeria-item[hidden] { display: none; }
.galeria-item__img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}
/* Las ilustraciones SVG no compiten con las fotos reales: fondo claro de marca
   para que se lean como lo que son. */
.galeria-item--ilustracion { background: var(--color-accent-warm, #FFE8E0) !important; }
/* Con foto, el degradado del overlay tiene que ser más fuerte para que lea el título. */
.galeria-item:has(.galeria-item__img) .galeria-item__overlay {
  background: linear-gradient(to top, rgba(0,0,0,0.65) 0%, rgba(0,0,0,0.1) 55%, transparent 100%);
}
.galeria-filtros {
  display: flex;
  gap: 0.5rem;
  overflow-x: auto;
  scrollbar-width: none;
  padding-bottom: 2px;
}
.galeria-vacio {
  margin-top: var(--spacing-xl);
  text-align: center;
  color: var(--color-text-light);
}
.galeria-item--wide {
  grid-column: span 2;
  aspect-ratio: 16/7;
}
.galeria-item__overlay {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  background: linear-gradient(to top, rgba(0,0,0,0.4) 0%, transparent 60%);
  transition: background var(--transition-base);
}
.galeria-item:hover .galeria-item__overlay {
  background: linear-gradient(to top, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0.1) 100%);
}
.galeria-item__emoji {
  font-size: 3rem;
  filter: drop-shadow(0 2px 8px rgba(0,0,0,0.3));
}
.galeria-item__info {
  position: absolute;
  bottom: 0.875rem;
  left: 0.875rem;
  right: 0.875rem;
}
.galeria-item__cat {
  display: block;
  font-size: 0.65rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: rgba(255,255,255,0.75);
  margin-bottom: 0.2rem;
}
.galeria-item__title {
  display: block;
  font-size: var(--font-size-sm);
  font-weight: 700;
  color: #fff;
  line-height: 1.3;
}
</style>

<script>
  const filtros = document.querySelectorAll<HTMLButtonElement>('.galeria-filtros [data-filtro]');
  const items = document.querySelectorAll<HTMLElement>('.galeria-item[data-cat]');
  const vacio = document.querySelector<HTMLElement>('.galeria-vacio');

  filtros.forEach(btn => {
    btn.addEventListener('click', () => {
      const filtro = btn.dataset.filtro ?? 'todos';

      filtros.forEach(b => {
        const activo = b === btn;
        b.classList.toggle('cat-bar__btn--active', activo);
        b.setAttribute('aria-pressed', String(activo));
      });

      let visibles = 0;
      items.forEach(item => {
        const coincide = filtro === 'todos' || item.dataset.cat === filtro;
        item.hidden = !coincide;
        if (coincide) visibles++;
      });

      if (vacio) vacio.hidden = visibles > 0;
    });
  });
</script>
