---
import PageLayout from "@/layouts/PageLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import CTABanner from "@/components/CTABanner.astro";
import LeadCapture from "@/components/LeadCapture.astro";
import { SITE } from "@/data/site";
import { Image } from "astro:assets";
import castilloPrincesas from "@/assets/inflables/castillo-princesas/castillo-princesas-renta-cdmx.avif";
import barcoPirata from "@/assets/inflables/barco-pirata/barco-pirata-exterior-evento.avif";
import gusanitos from "@/assets/inflables/gusanitos/gusanitos-brincolin-evento.avif";
import dragonesRojos from "@/assets/inflables/dragones-rojos/castillo-dragones-renta-cdmx.avif";
import extremoCorporativo from "@/assets/inflables/pista-extremo/extremo-angulo-corporativo.avif";
import ringBoxeo from "@/assets/ilustraciones/ring-de-boxeo-inflable.svg";
import extremoGrande from "@/assets/inflables/pista-extremo/alquiler-inflable-extremo-grande-fiestas.avif";
import miniCastillo from "@/assets/inflables/mini-castillo/mini-castillo-cumpleanos-infantil.avif";
import miniJungla from "@/assets/inflables/mini-jungla/mini-jungla-exterior-evento.avif";
import princesasFiesta from "@/assets/inflables/castillo-princesas/mini-castillo-princesas-fiesta.avif";
import toroMecanico from "@/assets/ilustraciones/toro-mecanico-inflable.svg";
import extremoKermes from "@/assets/inflables/pista-extremo/alquiler-circuito-obstaculos-inflable-cdmx.avif";
import "@/styles/galeria.css";

const categorias = [
  "Castillos Inflables",
  "Toboganes Acuáticos",
  "Pistas de Obstáculos",
  "Juegos Interactivos",
  "Fiestas Infantiles",
  "Eventos Escolares",
];

const galeria = [
  // `img` es la foto real del inflable que se usó en ese evento.
  // Los dos marcados con `ilustracion` no son foto de evento: son ilustración de marca
  // (SVG) porque de esos dos juegos todavía no hay fotografía propia.
  { cat: "Fiestas Infantiles", gradient: "linear-gradient(135deg, #FF4B1F22 0%, #FFD70022 100%)", emoji: "🎂", title: "Cumpleaños princesas en Coyoacán", img: castilloPrincesas, w: 1200, h: 675 },
  { cat: "Toboganes Acuáticos", gradient: "linear-gradient(135deg, #1A1A2E22 0%, #0077CC22 100%)", emoji: "🌊", title: "Barco pirata con tobogán en Naucalpan", img: barcoPirata, w: 1200, h: 675 },
  { cat: "Eventos Escolares", gradient: "linear-gradient(135deg, #16a34a15 0%, #16a34a08 100%)", emoji: "🏫", title: "Kermés escuela primaria Edomex", img: gusanitos, w: 1200, h: 675 },
  { cat: "Castillos Inflables", gradient: "linear-gradient(135deg, #FF4B1F20 0%, #FFD70015 100%)", emoji: "🏰", title: "Castillo dragón en Iztapalapa", img: dragonesRojos, w: 1200, h: 675 },
  { cat: "Pistas de Obstáculos", gradient: "linear-gradient(135deg, #FF4B1F18 0%, #1A1A2E12 100%)", emoji: "🏃", title: "Pista obstáculos evento corporativo", img: extremoCorporativo, w: 1200, h: 675 },
  { cat: "Juegos Interactivos", gradient: "linear-gradient(135deg, #FFD70022 0%, #FF4B1F18 100%)", emoji: "🥊", title: "Ring de boxeo en quinceañera", img: ringBoxeo, w: 1200, h: 675, ilustracion: true },
  { cat: "Pistas de Obstáculos", gradient: "linear-gradient(135deg, #1A1A2E18 0%, #FF4B1F15 100%)", emoji: "🏃", title: "Pista de obstáculos para fiesta de verano", img: extremoGrande, w: 720, h: 480 },
  { cat: "Fiestas Infantiles", gradient: "linear-gradient(135deg, #FF4B1F15 0%, #FFD70022 100%)", emoji: "🎉", title: "Paquete cumpleaños en Benito Juárez", img: miniCastillo, w: 1200, h: 675 },
  { cat: "Eventos Escolares", gradient: "linear-gradient(135deg, #16a34a12 0%, #16a34a20 100%)", emoji: "🎓", title: "Festival fin de ciclo escolar", img: miniJungla, w: 1200, h: 675 },
  { cat: "Castillos Inflables", gradient: "linear-gradient(135deg, #FFD70018 0%, #FF4B1F20 100%)", emoji: "🏰", title: "Castillo princesas en GAM", img: princesasFiesta, w: 1200, h: 675 },
  { cat: "Juegos Interactivos", gradient: "linear-gradient(135deg, #FF4B1F18 0%, #FFD70015 100%)", emoji: "🤠", title: "Toro mecánico evento empresa", img: toroMecanico, w: 1200, h: 675, ilustracion: true },
  { cat: "Pistas de Obstáculos", gradient: "linear-gradient(135deg, #1A1A2E18 0%, #FF4B1F15 100%)", emoji: "🎪", title: "Pista obstáculos 15m en kermés", img: extremoKermes, w: 720, h: 480 },
];

const slug = (t: string) =>
  t.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
---

<PageLayout
  title="Galería de Eventos con Inflables — Fiestas y Kermeses | INFLABLEE"
  description="Galería de fotos de eventos con inflables INFLABLEE: cumpleaños infantiles, kermeses escolares, eventos corporativos y más en CDMX y Estado de México."
  breadcrumbs={[{ name: "Inicio", href: "/" }, { name: "Galería" }]}
>
  <main id="contenido-principal">
    <PageHero
      eyebrow="Galería de eventos"
      title="Momentos de pura\n<span>diversión inflable</span>"
      desc="Explora imágenes de inflables para fiestas, kermeses y eventos en CDMX y Estado de México."
      ctas={[
        { href: `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent("Hola INFLABLEE, vi la galería y quiero cotizar para mi evento.")}`, label: "Quiero esto para mi fiesta", variant: "primary" },
        { href: "/inflables/", label: "Ver catálogo", variant: "outline" },
      ]}
    />

    <!-- Filtros de categoría -->
    <nav style="background:var(--color-white);border-bottom:2px solid var(--color-border);padding:1rem 0;position:sticky;top:72px;z-index:100;">
      <div class="container">
        <div class="galeria-filtros" role="group" aria-label="Filtrar galería por categoría">
          <button type="button" class="cat-bar__btn cat-bar__btn--active" data-filtro="todos" aria-pressed="true">Todos</button>
          {categorias.map(c => (
            <button type="button" class="cat-bar__btn" data-filtro={slug(c)} aria-pressed="false">{c}</button>
          ))}
        </div>
      </div>
    </nav>

    <!-- Galería grid -->
    <section style="padding:var(--spacing-3xl) 0;background:var(--color-accent);" id="galeria">
      <div class="container">
        <SectionHeader
          title="Nuestros mejores momentos"
          subtitle="Cada foto representa una fiesta exitosa y familias felices."
        />
        <div class="galeria-grid" style="margin-top:var(--spacing-xl);">
          {galeria.map((item, i) => (
            <figure
              class={`galeria-item${i === 0 || i === 7 ? " galeria-item--wide" : ""}${item.ilustracion ? " galeria-item--ilustracion" : ""}`}
              style={`background:${item.gradient};`}
              data-cat={slug(item.cat)}
            >
              {item.img && (item.ilustracion ? (
                <img
                  src={item.img.src}
                  alt={`Ilustración de ${item.title.toLowerCase()} — INFLABLEE`}
                  width={item.w}
                  height={item.h}
                  loading="lazy"
                  decoding="async"
                  class="galeria-item__img"
                />
              ) : (
                <Image
                  src={item.img}
                  alt={`${item.title} — renta de inflables INFLABLEE`}
                  widths={[360, 720, 1200]}
                  sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                  loading={i === 0 ? "eager" : "lazy"}
                  fetchpriority={i === 0 ? "high" : "auto"}
                  decoding="async"
                  class="galeria-item__img"
                />
              ))}
              <figcaption class="galeria-item__overlay">
                {!item.img && <span class="galeria-item__emoji">{item.emoji}</span>}
                <div class="galeria-item__info">
                  <span class="galeria-item__cat">
                    {item.cat}{item.ilustracion && " · Ilustración"}
                  </span>
                  <span class="galeria-item__title">{item.title}</span>
                </div>
              </figcaption>
            </figure>
          ))}
        </div>
        <p class="galeria-vacio" hidden>No hay fotos en esta categoría todavía. Escríbenos y te mandamos las del evento que te interese.</p>
      </div>
    </section>

    <!-- CTA social proof -->
    <section style="padding:var(--spacing-3xl) 0;text-align:center;">
      <div class="container" style="max-width:680px;">
        <h2 style="font-size:clamp(1.5rem,3vw,2rem);font-weight:800;color:var(--color-secondary);margin-bottom:1rem;">¿Tu fiesta podría ser la próxima?</h2>
        <p style="color:var(--color-text-light);font-size:var(--font-size-lg);line-height:1.7;margin-bottom:var(--spacing-xl);">
          Revisa el catálogo para comparar medidas, capacidad y requisitos de los inflables disponibles.
        </p>
        <a href={`https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent("Hola INFLABLEE, vi la galería y quiero cotizar inflables para mi evento.")}`}
          class="btn btn--primary" target="_blank" rel="noopener" style="font-size:var(--font-size-base);padding:1rem 2rem;">
          Cotizar mi evento ahora →
        </a>
      </div>
    </section>

    <CTABanner />
    <LeadCapture />
  </main>
</PageLayout>


<script>
  const filtros = document.querySelectorAll<HTMLButtonElement>('.galeria-filtros [data-filtro]');
  const items = document.querySelectorAll<HTMLElement>('.galeria-item[data-cat]');
  const vacio = document.querySelector<HTMLElement>('.galeria-vacio');

  filtros.forEach(btn => {
    btn.addEventListener('click', () => {
      const filtro = btn.dataset.filtro ?? 'todos';

      filtros.forEach(b => {
        const activo = b === btn;
        b.classList.toggle('cat-bar__btn--active', activo);
        b.setAttribute('aria-pressed', String(activo));
      });

      let visibles = 0;
      items.forEach(item => {
        const coincide = filtro === 'todos' || item.dataset.cat === filtro;
        item.hidden = !coincide;
        if (coincide) visibles++;
      });

      if (vacio) vacio.hidden = visibles > 0;
    });
  });
</script>
