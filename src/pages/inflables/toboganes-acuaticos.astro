---
import PageLayout from "@/layouts/PageLayout.astro";
import PageHero from "@/components/PageHero.astro";
import InflableCard from "@/components/InflableCard.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import CTABanner from "@/components/CTABanner.astro";
import LeadCapture from "@/components/LeadCapture.astro";
import { SITE } from "@/data/site";
import { getCollection } from "astro:content";

const todos = await getCollection("inflables");
const inflables = todos
  .filter(i => i.data.categoria === "toboganes-acuaticos")
  .sort((a, b) => a.data.order - b.data.order);
---

<PageLayout
  title="Renta Toboganes Acuáticos CDMX — Inflables de Agua | INFLABLEE"
  description="Toboganes acuáticos inflables para fiestas en CDMX y EdoMex. Desde $1,800 MXN con instalación, supervisor y manguera incluidos. Reserva tu fecha hoy."
  breadcrumbs={[{ name: "Inicio", href: "/" }, { name: "Inflables", href: "/inflables" }, { name: "Toboganes Acuáticos" }]}
>
  <main id="contenido-principal">
    <PageHero
      eyebrow="Inflables acuáticos para fiestas en CDMX"
      title="Toboganes Acuáticos Inflables\n<span>para Fiestas en CDMX y EdoMex</span>"
      desc="Toboganes con chapoteadero, albercas inflables y doble carril para niños de 3 a 14 años. Solo necesitas un jardín y una manguera — el resto lo llevamos nosotros."
      ctas={[
        { href: `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent("Hola INFLABLEE, quiero cotizar un tobogán acuático inflable para mi evento.")}`, label: "Cotizar tobogán acuático", variant: "primary" },
        { href: "/inflables", label: "Ver todo el catálogo", variant: "outline" },
      ]}
      stats={[
        { value: "1.5-5m", label: "Alturas disponibles" },
        { value: "100%", label: "Supervisión incluida" },
        { value: "CDMX+EdoMex", label: "Cobertura sin costo" },
      ]}
    />

    <section class="prod-catalog">
      <div class="container">
        <SectionHeader
          title="Toboganes acuáticos disponibles"
          subtitle="Desde albercas para bebés hasta toboganes gigantes de 5 metros. Encuentra el ideal para tu evento."
        />
        <div class="prod-catalog__grid">
          {inflables.map(i => (
            <InflableCard
              title={i.data.title}
              descripcion={i.data.descripcion}
              categoria={i.data.categoria}
              precio_desde={i.data.precio_desde}
              capacidad={i.data.capacidad}
              medidas={i.data.medidas}
              tiempo_instalacion={i.data.tiempo_instalacion}
              slug={i.data.slug}
              disponible={i.data.disponible}
              featured={i.data.featured}
              gradient="linear-gradient(135deg, #1A1A2E18 0%, #0077CC18 100%)"
            />
          ))}
        </div>
      </div>
    </section>

    <!-- SEO Content -->
    <section style="padding:var(--spacing-3xl) 0;background:var(--color-accent);">
      <div class="container">
        <div class="section__seo" style="margin-top:0;padding-top:0;border-top:none;">
          <div class="section__seo-block">
            <p class="section__seo-label">INFLABLES ACUÁTICOS PARA CUMPLEAÑOS EN CDMX · TEMPORADA MARZO–OCTUBRE</p>
            <h2 class="section__seo-title">El tobogán acuático más rentado en CDMX: desde $1,800 MXN con supervisor e instalación incluida</h2>
            <p class="section__seo-text">Los <strong>toboganes acuáticos inflables</strong> son el inflable más solicitado de marzo a octubre en Ciudad de México. Con temperaturas que superan los 28°C entre mayo y agosto, el agua convierte cualquier cumpleaños o kermés en el evento que los niños recordarán por años. En temporada alta (julio–agosto), los toboganes acuáticos se reservan con 3 semanas de anticipación — asegura tu fecha hoy.</p>
          </div>
          <div class="section__seo-block">
            <p class="section__seo-label">¿QUÉ TOBOGÁN ACUÁTICO ES EL CORRECTO PARA TU EVENTO?</p>
            <h2 class="section__seo-title">Para 10 niños o para 200: tenemos el tobogán acuático del tamaño exacto que necesitas</h2>
            <p class="section__seo-text">Albercas inflables para bebés de 0 a 3 años (sin soplador, solo agua), toboganes de carril único de 3 metros para jardines medianos, y modelos de doble carril de 5 metros para eventos grandes donde los niños compiten. Solo necesitas <strong>una manguera de jardín estándar</strong> — nosotros llevamos el soplador, la lona impermeable, el anclaje y el supervisor. El agua no se incluye pero siempre recomendamos la cantidad exacta para tu modelo.</p>
          </div>
        </div>
      </div>
    </section>

    <CTABanner
      title="¿Listo para el tobogán más divertido del verano?"
      subtitle="Reserva con anticipación. Los toboganes acuáticos se agotan rápido en temporada alta."
    />
    <LeadCapture />
  </main>
</PageLayout>
