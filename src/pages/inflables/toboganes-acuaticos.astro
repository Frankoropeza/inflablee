---
import PageLayout from "@/layouts/PageLayout.astro";
import PageHero from "@/components/PageHero.astro";
import InflableCard from "@/components/InflableCard.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import CTABanner from "@/components/CTABanner.astro";
import LeadCapture from "@/components/LeadCapture.astro";
import { SITE } from "@/data/site";
import { getCollection } from "astro:content";

const todos = await getCollection("inflables");
const inflables = todos
  .filter(i => i.data.categoria === "toboganes-acuaticos")
  .sort((a, b) => a.data.order - b.data.order);
---

<PageLayout
  title="Toboganes Acuáticos para Renta CDMX y Edomex | INFLABLEE"
  description="Renta de toboganes acuáticos inflables en CDMX y Estado de México. Toboganes con chapoteadero, doble carril y albercas inflables. Perfectos para el verano."
  breadcrumbs={[{ name: "Inicio", href: "/" }, { name: "Inflables", href: "/inflables" }, { name: "Toboganes Acuáticos" }]}
>
  <main id="contenido-principal">
    <PageHero
      eyebrow="Toboganes acuáticos"
      title="Toboganes de agua para\n<span>fiestas de verano</span>"
      desc="Diversión y frescura en uno. Toboganes con chapoteadero, doble carril y albercas inflables para fiestas en jardín. ¡El hit del verano en CDMX!"
      ctas={[
        { href: `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent("Hola INFLABLEE, quiero cotizar un tobogán acuático.")}`, label: "Cotizar tobogán", variant: "primary" },
        { href: "/inflables", label: "Ver todo el catálogo", variant: "outline" },
      ]}
      stats={[
        { value: "1.5-5m", label: "Alturas disponibles" },
        { value: "100%", label: "Supervisión incluida" },
        { value: "CDMX", label: "Cobertura" },
      ]}
    />

    <section class="prod-catalog">
      <div class="container">
        <SectionHeader
          title="Toboganes acuáticos disponibles"
          subtitle="Desde albercas para bebés hasta toboganes gigantes de 5 metros. Encuentra el ideal para tu evento."
        />
        <div class="prod-catalog__grid">
          {inflables.map(i => (
            <InflableCard
              title={i.data.title}
              descripcion={i.data.descripcion}
              categoria={i.data.categoria}
              precio_desde={i.data.precio_desde}
              capacidad={i.data.capacidad}
              medidas={i.data.medidas}
              tiempo_instalacion={i.data.tiempo_instalacion}
              slug={i.data.slug}
              disponible={i.data.disponible}
              featured={i.data.featured}
              gradient="linear-gradient(135deg, #1A1A2E18 0%, #0077CC18 100%)"
            />
          ))}
        </div>
      </div>
    </section>

    <!-- SEO Content -->
    <section style="padding:var(--spacing-3xl) 0;background:var(--color-accent);">
      <div class="container">
        <div class="section__seo" style="margin-top:0;padding-top:0;border-top:none;">
          <div class="section__seo-block">
            <p class="section__seo-label">EL REMEDIO PARA EL CALOR DE CDMX</p>
            <h2 class="section__seo-title">Un tobogán de agua en tu jardín — porque los niños recuerdan las fiestas con agua toda la vida</h2>
            <p class="section__seo-text">Los <strong>toboganes acuáticos inflables</strong> son el inflable más solicitado entre marzo y octubre en Ciudad de México. Con temperaturas que superan los 28°C, el agua convierte cualquier cumpleaños o kermés en una aventura que los niños recordarán mucho más que cualquier piñata.</p>
          </div>
          <div class="section__seo-block">
            <p class="section__seo-label">DESDE ALBERCAS HASTA TOBOGANES DE 5 METROS</p>
            <h2 class="section__seo-title">No todos los toboganes son iguales — te ayudamos a elegir el que se adapta a tu espacio y tu evento</h2>
            <p class="section__seo-text">Tenemos albercas inflables para los bebés, toboganes de carril único para espacios medianos y modelos de <strong>doble carril para que los niños compitan</strong>. Solo necesitas una manguera de jardín; nosotros llevamos todo lo demás, incluyendo la lona de piso impermeable y el soplador eléctrico.</p>
          </div>
        </div>
      </div>
    </section>

    <CTABanner
      title="¿Listo para el tobogán más divertido del verano?"
      subtitle="Reserva con anticipación. Los toboganes acuáticos se agotan rápido en temporada alta."
    />
    <LeadCapture />
  </main>
</PageLayout>
