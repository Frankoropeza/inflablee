---
import PageLayout from "@/layouts/PageLayout.astro";
import PageHero from "@/components/PageHero.astro";
import InflableCard from "@/components/InflableCard.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import CTABanner from "@/components/CTABanner.astro";
import LeadCapture from "@/components/LeadCapture.astro";
import { SITE } from "@/data/site";
import { getCollection } from "astro:content";

const todos = await getCollection("inflables");
// Inflables grandes = toboganes grandes + pistas de obstáculos
const inflables = todos
  .filter(i => i.data.categoria === "toboganes-acuaticos" || i.data.categoria === "pistas-obstaculos")
  .sort((a, b) => a.data.order - b.data.order);
---

<PageLayout
  title="Renta Inflables Gigantes CDMX — Pistas y Toboganes de 5–8 m | INFLABLEE"
  description="Inflables gigantes para kermeses, festivales y eventos corporativos en CDMX. Pista de obstáculos 8 m y toboganes de hasta 5 m. Supervisor incluido. Cotiza hoy."
  breadcrumbs={[{ name: "Inicio", href: "/" }, { name: "Inflables", href: "/inflables" }, { name: "Inflables Gigantes" }]}
>
  <main id="contenido-principal">
    <PageHero
      eyebrow="Inflables gigantes"
      title="Inflables de gran formato\npara <span>eventos épicos</span>"
      desc="Toboganes de 5 metros, pistas de obstáculos de 15 metros y más. Para eventos donde la diversión debe ser tan grande como la celebración."
      ctas={[
        { href: `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent("Hola INFLABLEE, quiero cotizar inflables gigantes para mi evento.")}`, label: "Cotizar ahora", variant: "primary" },
        { href: "/inflables", label: "Ver todo el catálogo", variant: "outline" },
      ]}
      stats={[
        { value: "5m", label: "Altura máxima" },
        { value: "15m", label: "Pista más larga" },
        { value: "200+", label: "Niños por turno" },
      ]}
    />

    <section class="prod-catalog">
      <div class="container">
        <SectionHeader
          title="Inflables de gran formato"
          subtitle="Perfectos para eventos masivos, kermeses escolares y festivales comunitarios."
        />
        <div class="prod-catalog__grid">
          {inflables.map(i => (
            <InflableCard
              title={i.data.title}
              descripcion={i.data.descripcion}
              categoria={i.data.categoria}
              precio_desde={i.data.precio_desde}
              capacidad={i.data.capacidad}
              medidas={i.data.medidas}
              tiempo_instalacion={i.data.tiempo_instalacion}
              slug={i.data.slug}
              disponible={i.data.disponible}
              featured={i.data.featured}
              gradient="linear-gradient(135deg, #1A1A2E18 0%, #FF4B1F15 100%)"
            />
          ))}
        </div>
      </div>
    </section>

    <!-- SEO Content -->
    <section style="padding:var(--spacing-3xl) 0;background:var(--color-accent);">
      <div class="container">
        <div class="section__seo" style="margin-top:0;padding-top:0;border-top:none;">
          <div class="section__seo-block">
            <p class="section__seo-label">CUANDO EL EVENTO LO EXIGE</p>
            <h2 class="section__seo-title">Toboganes de 5 metros y pistas de 15 — inflables de gran formato para eventos que no pasan desapercibidos</h2>
            <p class="section__seo-text">Para kermeses escolares, festivales comunitarios y eventos corporativos masivos, los <strong>inflables gigantes</strong> son la única opción que está a la altura. Más de 200 niños pueden disfrutarlos en un solo turno, con supervisión profesional incluida en todo momento y seguro de responsabilidad civil vigente.</p>
          </div>
          <div class="section__seo-block">
            <p class="section__seo-label">LOGÍSTICA ESPECIALIZADA PARA EVENTOS GRANDES</p>
            <h2 class="section__seo-title">Tenemos la experiencia para montar múltiples inflables gigantes en el mismo evento, sin caos</h2>
            <p class="section__seo-text">Coordinamos la instalación simultánea de varios <strong>inflables de gran formato</strong>, incluyendo generadores eléctricos opcionales y plan de rotación de participantes. Si tu evento tiene más de 100 asistentes, necesitas un equipo que ya lo haya hecho antes. Nosotros sí, más de 150 veces.</p>
          </div>
        </div>
      </div>
    </section>

    <CTABanner
      title="¿Tienes un evento grande?"
      subtitle="Para kermeses, festivales y eventos corporativos tenemos paquetes especiales con múltiples inflables y supervisores."
    />
    <LeadCapture />
  </main>
</PageLayout>
