---
import PageLayout from "@/layouts/PageLayout.astro";
import PageHero from "@/components/PageHero.astro";
import InflableCard from "@/components/InflableCard.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import CTABanner from "@/components/CTABanner.astro";
import LeadCapture from "@/components/LeadCapture.astro";
import { SITE } from "@/data/site";
import { getCollection } from "astro:content";

const todos = await getCollection("inflables");
const inflables = todos
  .filter(i => i.data.categoria === "pistas-obstaculos")
  .sort((a, b) => a.data.order - b.data.order);
---

<PageLayout
  title="Renta Pista de Obstáculos Inflable CDMX — Desde $3,000 | INFLABLEE"
  description="Pistas de obstáculos inflables para kermeses, eventos corporativos y fiestas en CDMX. 8 metros, túneles, escalada y tobogán. Supervisor incluido. Cotiza hoy."
  breadcrumbs={[{ name: "Inicio", href: "/" }, { name: "Inflables", href: "/inflables" }, { name: "Pistas de Obstáculos" }]}
>
  <main id="contenido-principal">
    <PageHero
      eyebrow="Circuito de obstáculos inflable en CDMX"
      title="Pistas de Obstáculos Inflables\n<span>para Kermeses y Eventos en CDMX</span>"
      desc="8 metros de recorrido completo: túneles, montañas de escalar, columnas esquivadoras y tobogán final. Para niños de 6 años en adelante y adultos hasta 90 kg."
      ctas={[
        { href: `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent("Hola INFLABLEE, quiero cotizar una pista de obstáculos inflable para mi evento.")}`, label: "Cotizar pista de obstáculos", variant: "primary" },
        { href: "/inflables", label: "Ver todo el catálogo", variant: "outline" },
      ]}
    />

    <section class="prod-catalog">
      <div class="container">
        <SectionHeader
          title="Pistas de obstáculos disponibles"
          subtitle="Desde pistas básicas hasta profesionales de 15 metros. Ideales para eventos escolares y kermeses."
        />
        <div class="prod-catalog__grid">
          {inflables.map(i => (
            <InflableCard
              title={i.data.title}
              descripcion={i.data.descripcion}
              categoria={i.data.categoria}
              precio_desde={i.data.precio_desde}
              capacidad={i.data.capacidad}
              medidas={i.data.medidas}
              tiempo_instalacion={i.data.tiempo_instalacion}
              slug={i.data.slug}
              disponible={i.data.disponible}
              featured={i.data.featured}
              gradient="linear-gradient(135deg, #FF4B1F15 0%, #FF4B1F08 100%)"
            />
          ))}
        </div>
      </div>
    </section>

    <!-- SEO Content -->
    <section style="padding:var(--spacing-3xl) 0;background:var(--color-accent);">
      <div class="container">
        <div class="section__seo" style="margin-top:0;padding-top:0;border-top:none;">
          <div class="section__seo-block">
            <p class="section__seo-label">PISTA DE OBSTÁCULOS INFLABLE CDMX · DESDE $3,000 MXN CON TODO INCLUIDO</p>
            <h2 class="section__seo-title">8 metros de circuito completo: la atracción que convierte tu kermés o evento corporativo en el del año</h2>
            <p class="section__seo-text">Túnel de entrada, montañas dobles de escalar, zona de columnas esquivadoras y tobogán final de 2 metros: la <strong>Pista Extremo</strong> es el inflable con mayor capacidad de atención por hora de todo el catálogo. Diseñada para uso intensivo extendido — la hemos operado 8 horas continuas en una kermés con 280 estudiantes en Iztapalapa sin falla. El throughput promedio es de 40–60 participantes por hora con sistema de turnos de 4–5 minutos.</p>
          </div>
          <div class="section__seo-block">
            <p class="section__seo-label">PARA NIÑOS DE 6 AÑOS Y ADULTOS HASTA 90 KG · TEAM BUILDING CORPORATIVO</p>
            <h2 class="section__seo-title">Relevos, competencias cronometradas y dinámicas de equipo que papás y empleados recuerdan más que los niños</h2>
            <p class="section__seo-text">La <strong>pista de obstáculos inflable</strong> es el inflable que más adultos atrae de todo el catálogo. Diseñada para participantes hasta 90 kg, genera competencias de equipos espontáneas — relevos de 4 vs 4, cronometradas por estación — que son perfectas para team building corporativo, convivencias escolares y eventos de fin de año empresarial. El supervisor puede coordinar la dinámica si lo solicitas al reservar.</p>
          </div>
        </div>
      </div>
    </section>

    <CTABanner
      title="¿Organizas un evento escolar o corporativo?"
      subtitle="Tenemos paquetes especiales para kermeses, días del niño y eventos empresariales. Cotiza sin compromiso."
    />
    <LeadCapture />
  </main>
</PageLayout>
