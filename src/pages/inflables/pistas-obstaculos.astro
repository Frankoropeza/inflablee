---
import PageLayout from "@/layouts/PageLayout.astro";
import PageHero from "@/components/PageHero.astro";
import InflableCard from "@/components/InflableCard.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import CTABanner from "@/components/CTABanner.astro";
import LeadCapture from "@/components/LeadCapture.astro";
import { SITE } from "@/data/site";
import { getCollection } from "astro:content";

const todos = await getCollection("inflables");
const inflables = todos
  .filter(i => i.data.categoria === "pistas-obstaculos")
  .sort((a, b) => a.data.order - b.data.order);
---

<PageLayout
  title="Pistas de Obstáculos Inflables para Renta CDMX | INFLABLEE"
  description="Renta de pistas de obstáculos inflables en CDMX y Estado de México. Hasta 15 metros de recorrido con túneles, montañas y tobogán. Perfectas para eventos escolares."
  breadcrumbs={[{ name: "Inicio", href: "/" }, { name: "Inflables", href: "/inflables" }, { name: "Pistas de Obstáculos" }]}
>
  <main id="contenido-principal">
    <PageHero
      eyebrow="Pistas de obstáculos"
      title="Adrenalina pura con\n<span>pistas de obstáculos</span>"
      desc="15 metros de pura diversión: túneles, montañas, saltos y tobogán final. La actividad favorita en eventos escolares y corporativos. Para niños y adultos."
      ctas={[
        { href: `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent("Hola INFLABLEE, quiero cotizar una pista de obstáculos.")}`, label: "Cotizar pista", variant: "primary" },
        { href: "/inflables", label: "Ver todo el catálogo", variant: "outline" },
      ]}
    />

    <section class="prod-catalog">
      <div class="container">
        <SectionHeader
          title="Pistas de obstáculos disponibles"
          subtitle="Desde pistas básicas hasta profesionales de 15 metros. Ideales para eventos escolares y kermeses."
        />
        <div class="prod-catalog__grid">
          {inflables.map(i => (
            <InflableCard
              title={i.data.title}
              descripcion={i.data.descripcion}
              categoria={i.data.categoria}
              precio_desde={i.data.precio_desde}
              capacidad={i.data.capacidad}
              medidas={i.data.medidas}
              tiempo_instalacion={i.data.tiempo_instalacion}
              slug={i.data.slug}
              disponible={i.data.disponible}
              featured={i.data.featured}
              gradient="linear-gradient(135deg, #FF4B1F15 0%, #FF4B1F08 100%)"
            />
          ))}
        </div>
      </div>
    </section>

    <!-- SEO Content -->
    <section style="padding:var(--spacing-3xl) 0;background:var(--color-accent);">
      <div class="container">
        <div class="section__seo" style="margin-top:0;padding-top:0;border-top:none;">
          <div class="section__seo-block">
            <p class="section__seo-label">PARA LOS QUE NECESITAN MÁS QUE UN CASTILLO</p>
            <h2 class="section__seo-title">15 metros de adrenalina pura: la atracción que convierte tu kermés en el evento del año</h2>
            <p class="section__seo-text">Túneles, montañas de escalar, zonas de saltos y tobogán final: la <strong>pista de obstáculos inflable</strong> es el inflable más versátil para eventos escolares, corporativos y fiestas grandes en CDMX. Aguanta uso intensivo de hasta 200 niños por día sin perder ni un gramo de diversión.</p>
          </div>
          <div class="section__seo-block">
            <p class="section__seo-label">NO ES SOLO PARA NIÑOS — LOS ADULTOS TAMBIÉN HACEN FILA</p>
            <h2 class="section__seo-title">Relevos por equipos, competencias cronometradas y team building que nadie olvida</h2>
            <p class="section__seo-text">Las <strong>pistas de obstáculos inflables</strong> son perfectas para dinámicas de convivencia escolar y team building corporativo. Organizamos relevos y competencias cronometradas que enganchan tanto a los niños como a los papás y maestros. Diversión que une a toda la comunidad.</p>
          </div>
        </div>
      </div>
    </section>

    <CTABanner
      title="¿Organizas un evento escolar o corporativo?"
      subtitle="Tenemos paquetes especiales para kermeses, días del niño y eventos empresariales. Cotiza sin compromiso."
    />
    <LeadCapture />
  </main>
</PageLayout>
