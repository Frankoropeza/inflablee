---
import PageLayout from "@/layouts/PageLayout.astro";
import CTABanner from "@/components/CTABanner.astro";
import LeadCapture from "@/components/LeadCapture.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import InflableCard from "@/components/InflableCard.astro";
import { SITE } from "@/data/site";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const inflables = await getCollection("inflables");
  return inflables.map(i => ({
    params: { slug: i.slug },
    props: { inflable: i },
  }));
}

const { inflable } = Astro.props;
const { Content } = await inflable.render();

const todosInflables = await getCollection("inflables");
const relacionados = todosInflables
  .filter(i => i.data.categoria === inflable.data.categoria && i.slug !== inflable.slug)
  .slice(0, 3);

const waText = encodeURIComponent(`Hola INFLABLEE, me interesa rentar: ${inflable.data.title}. ¿Cuál es la disponibilidad y precio exacto?`);

const categoriaColors: Record<string, string> = {
  "castillos":    "#FF4B1F",
  "toboganes":    "#0077CC",
  "pistas":       "#7C3AED",
  "interactivos": "#D97706",
};
const categoriaLabels: Record<string, string> = {
  "castillos":    "Castillo Inflable",
  "toboganes":    "Tobogán",
  "pistas":       "Pista de Obstáculos",
  "interactivos": "Juego Interactivo",
};

const catColor = categoriaColors[inflable.data.categoria] ?? "#6B7280";
const catLabel = categoriaLabels[inflable.data.categoria] ?? inflable.data.categoria;

const imagenes: string[] = inflable.data.imagenes ?? [];
const mainImage = inflable.data.imagen ?? (imagenes.length > 0 ? imagenes[0] : null);
const galleryImages = imagenes.length > 0 ? imagenes : (mainImage ? [mainImage] : []);

const schema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": inflable.data.title,
  "description": inflable.data.descripcion,
  ...(mainImage ? { "image": `${SITE.url}${mainImage}` } : {}),
  "offers": {
    "@type": "Offer",
    "priceCurrency": "MXN",
    "price": inflable.data.precio_desde,
    "availability": inflable.data.disponible ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
    "seller": { "@type": "Organization", "name": SITE.name }
  }
};
---

<PageLayout
  title={`Renta ${inflable.data.title} CDMX — $${inflable.data.precio_desde.toLocaleString()} MXN | INFLABLEE`}
  description={`${inflable.data.descripcion.slice(0, 140)}. Entrega e instalación incluida en CDMX y Edomex.`}
  breadcrumbs={[
    { name: "Inicio", href: "/" },
    { name: "Inflables", href: "/inflables" },
    { name: inflable.data.title }
  ]}
  schema={schema}
>
  <main id="contenido-principal">

    <!-- DETAIL HERO -->
    <section class="idetail">
      <div class="container">
        <div class="idetail__inner">

          <!-- Galería de imágenes -->
          <div class="idetail__gallery">
            {mainImage ? (
              <div class="idetail__main-img-wrap">
                <img
                  src={mainImage}
                  alt={`Renta de ${inflable.data.title} en CDMX`}
                  width="600"
                  height="450"
                  loading="eager"
                  class="idetail__main-img"
                />
                {inflable.data.featured && (
                  <span class="idetail__featured-badge">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                    Más popular
                  </span>
                )}
              </div>
            ) : (
              <div class="idetail__main-img-placeholder">
                <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
              </div>
            )}

            {galleryImages.length > 1 && (
              <div class="idetail__thumbs">
                {galleryImages.map((img, i) => (
                  <img
                    src={img}
                    alt={`${inflable.data.title} vista ${i + 1}`}
                    width="100"
                    height="75"
                    loading="lazy"
                    class="idetail__thumb"
                    onclick={`document.querySelector('.idetail__main-img').src='${img}'`}
                  />
                ))}
              </div>
            )}

            <!-- Specs strip -->
            <div class="idetail__strip">
              <div class="idetail__strip-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
                <span class="idetail__strip-value">{inflable.data.capacidad}</span>
                <span class="idetail__strip-label">Capacidad</span>
              </div>
              <div class="idetail__strip-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 3H3v18h18V3z"/><path d="M9 3v18M15 3v18M3 9h18M3 15h18"/></svg>
                <span class="idetail__strip-value">{inflable.data.medidas}</span>
                <span class="idetail__strip-label">Medidas</span>
              </div>
              <div class="idetail__strip-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                <span class="idetail__strip-value">{inflable.data.tiempo_instalacion}</span>
                <span class="idetail__strip-label">Instalación</span>
              </div>
              <div class="idetail__strip-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>
                <span class="idetail__strip-value" style="color:var(--color-primary);">${inflable.data.precio_desde.toLocaleString()} MXN</span>
                <span class="idetail__strip-label">Desde</span>
              </div>
            </div>
          </div>

          <!-- Content -->
          <div class="idetail__content">
            <span class="idetail__cat" style={`color:${catColor};`}>
              {catLabel}
            </span>
            <h1 class="idetail__title">{inflable.data.title}</h1>
            <p class="idetail__desc">{inflable.data.descripcion}</p>

            <!-- Precio destacado -->
            <div class="idetail__price-box">
              <span class="idetail__price-from">Precio desde</span>
              <span class="idetail__price">${inflable.data.precio_desde.toLocaleString()} <small>MXN</small></span>
              <span class="idetail__price-note">Incluye entrega, instalación y supervisor</span>
            </div>

            <!-- Includes -->
            <div class="idetail__includes">
              <h3 class="idetail__includes-title">¿Qué incluye tu renta?</h3>
              <ul class="idetail__includes-list">
                <li>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  Entrega y retiro a domicilio
                </li>
                <li>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  Instalación y desinstalación profesional
                </li>
                <li>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  Soplador eléctrico incluido
                </li>
                <li>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  Supervisor capacitado durante el evento
                </li>
                <li>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  Seguro de responsabilidad civil
                </li>
                <li>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  Sanitización previa al evento
                </li>
                <li>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  Garantía de reembolso si llueve
                </li>
              </ul>
            </div>

            <div class="idetail__actions">
              <a
                href={`https://wa.me/${SITE.whatsapp}?text=${waText}`}
                class="btn btn--success idetail__cta"
                target="_blank"
                rel="noopener"
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                Cotizar por WhatsApp
              </a>
              <a href="/inflables" class="btn btn--outline">← Catálogo</a>
            </div>
          </div>
        </div>

        <!-- MDX Content -->
        {Content && (
          <div class="idetail__prose">
            <Content />
          </div>
        )}
      </div>
    </section>

    <!-- Relacionados -->
    {relacionados.length > 0 && (
      <section style="padding:var(--spacing-3xl) 0;background:var(--color-accent);">
        <div class="container">
          <SectionHeader
            title="También te puede interesar"
            subtitle="Más inflables para complementar tu evento."
          />
          <div class="inflables-grid" style="margin-top:var(--spacing-xl);">
            {relacionados.map(i => (
              <InflableCard
                title={i.data.title}
                descripcion={i.data.descripcion}
                categoria={i.data.categoria}
                precio_desde={i.data.precio_desde}
                capacidad={i.data.capacidad}
                medidas={i.data.medidas}
                tiempo_instalacion={i.data.tiempo_instalacion}
                slug={i.slug}
                imagen={i.data.imagen}
                disponible={i.data.disponible}
                featured={i.data.featured}
              />
            ))}
          </div>
        </div>
      </section>
    )}

    <CTABanner />
    <LeadCapture />
  </main>
</PageLayout>

<style>
.idetail {
  padding: var(--spacing-3xl) 0;
}
.idetail__inner {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--spacing-2xl);
}
@media (min-width: 968px) {
  .idetail__inner { grid-template-columns: 1.1fr 1fr; align-items: start; }
}

/* Gallery */
.idetail__gallery { display: flex; flex-direction: column; gap: 1rem; }
.idetail__main-img-wrap {
  position: relative;
  border-radius: var(--border-radius-lg);
  overflow: hidden;
  aspect-ratio: 4/3;
}
.idetail__main-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.idetail__main-img-placeholder {
  aspect-ratio: 4/3;
  background: var(--color-accent);
  border-radius: var(--border-radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-light);
}
.idetail__featured-badge {
  position: absolute;
  top: 1rem;
  left: 1rem;
  background: var(--color-primary);
  color: #fff;
  font-size: 0.75rem;
  font-weight: 700;
  padding: 0.35rem 0.9rem;
  border-radius: 50px;
  display: flex;
  align-items: center;
  gap: 0.3rem;
}
.idetail__thumbs {
  display: flex;
  gap: 0.5rem;
  overflow-x: auto;
}
.idetail__thumb {
  width: 80px;
  height: 60px;
  object-fit: cover;
  border-radius: var(--border-radius);
  cursor: pointer;
  border: 2px solid transparent;
  transition: border-color var(--transition-fast);
  flex-shrink: 0;
}
.idetail__thumb:hover { border-color: var(--color-primary); }

.idetail__strip {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 0.75rem;
  padding: 1.25rem;
  background: var(--color-secondary);
  border-radius: var(--border-radius-lg);
}
@media (min-width: 480px) {
  .idetail__strip { grid-template-columns: repeat(4, 1fr); }
}
.idetail__strip-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 0.2rem;
  color: rgba(255,255,255,0.6);
}
.idetail__strip-item svg { color: rgba(255,255,255,0.4); }
.idetail__strip-value {
  font-size: var(--font-size-base);
  font-weight: 800;
  color: #fff;
  line-height: 1;
}
.idetail__strip-label {
  font-size: 0.65rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

/* Content */
.idetail__content { display: flex; flex-direction: column; gap: 1.25rem; }
.idetail__cat {
  display: inline-block;
  font-size: var(--font-size-sm);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}
.idetail__title {
  font-size: clamp(1.75rem, 3vw, 2.5rem);
  font-weight: 900;
  color: var(--color-secondary);
  line-height: 1.1;
  margin: 0;
}
.idetail__desc {
  font-size: var(--font-size-lg);
  color: var(--color-text);
  line-height: 1.7;
  margin: 0;
}

.idetail__price-box {
  background: linear-gradient(135deg, #FFF8F5 0%, #FFE8E0 100%);
  border: 1.5px solid rgba(255,75,31,0.2);
  border-radius: var(--border-radius-lg);
  padding: 1.25rem;
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
}
.idetail__price-from {
  font-size: var(--font-size-xs);
  color: var(--color-text-light);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}
.idetail__price {
  font-size: 2.25rem;
  font-weight: 900;
  color: var(--color-primary);
  line-height: 1;
}
.idetail__price small {
  font-size: var(--font-size-lg);
  font-weight: 700;
}
.idetail__price-note {
  font-size: var(--font-size-xs);
  color: var(--color-text-light);
}

.idetail__includes {
  background: var(--color-accent);
  border-radius: var(--border-radius-lg);
  padding: 1.25rem;
}
.idetail__includes-title {
  font-size: var(--font-size-base);
  font-weight: 800;
  color: var(--color-secondary);
  margin: 0 0 0.875rem;
}
.idetail__includes-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}
.idetail__includes-list li {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: var(--font-size-sm);
  color: var(--color-text);
  font-weight: 500;
}
.idetail__includes-list li svg { color: #22C55E; flex-shrink: 0; }

.idetail__actions {
  display: flex;
  gap: 0.875rem;
  flex-wrap: wrap;
}
.idetail__cta {
  flex: 1;
  justify-content: center;
  gap: 0.5rem;
  min-width: 200px;
}

.btn--success {
  background: #25D366;
  color: #fff;
  border: none;
  display: inline-flex;
  align-items: center;
  padding: 0.875rem 1.5rem;
  border-radius: var(--border-radius);
  font-size: var(--font-size-base);
  font-weight: 700;
  text-decoration: none;
  transition: background var(--transition-fast), transform var(--transition-fast);
}
.btn--success:hover { background: #1da851; transform: translateY(-2px); }

.idetail__prose {
  margin-top: var(--spacing-2xl);
  padding-top: var(--spacing-2xl);
  border-top: 1px solid var(--color-border);
  max-width: 720px;
}
.idetail__prose :global(h2) {
  font-size: var(--font-size-xl);
  font-weight: 800;
  color: var(--color-secondary);
  margin: var(--spacing-xl) 0 var(--spacing-sm);
}
.idetail__prose :global(p) {
  color: var(--color-text-light);
  line-height: 1.8;
  margin-bottom: var(--spacing-md);
}
.idetail__prose :global(ul) {
  padding-left: 1.5rem;
  margin-bottom: var(--spacing-md);
}
.idetail__prose :global(li) {
  color: var(--color-text-light);
  line-height: 1.8;
  margin-bottom: 0.25rem;
}
.idetail__prose :global(strong) { color: var(--color-secondary); }

/* Grid */
.inflables-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: var(--spacing-xl);
}
</style>
