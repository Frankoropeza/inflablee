---
import { getCollection, render } from "astro:content";
import PageLayout from "@/layouts/PageLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import CTABanner from "@/components/CTABanner.astro";
import LeadCapture from "@/components/LeadCapture.astro";
import { SITE } from "@/data/site";
import { ZONAS_GEO } from "@/data/zonas";
import { CATEGORIAS } from "@/data/categorias";

export function getStaticPaths() { return ZONAS_GEO.map((zona) => ({ params: { slug: zona.slug }, props: { zona } })); }
type Zona = (typeof ZONAS_GEO)[number];
const { zona } = Astro.props as { zona: Zona };
const pagina = (await getCollection("zonasSeo")).find((entry) => entry.id === zona.slug);
if (!pagina) throw new Error(`Falta el contenido de zona ${zona.slug}.`);
const { Content } = await render(pagina);
const detalle = "places" in zona && zona.places.length > 0;
const places = detalle ? zona.places : [...zona.alcaldias, ...zona.municipios].map((nombre) => ({ nombre, colonias: [], destacada: false }));
const areaSchema = { "@context": "https://schema.org", "@type": "Service", name: `Renta de inflables en ${zona.nombre}`, serviceType: "Renta de inflables para eventos", provider: { "@id": `${SITE.url}/negocio` }, areaServed: places.map((place) => ({ "@type": "Place", name: place.nombre })) };
---

<PageLayout title={pagina.data.title} description={pagina.data.description} schema={areaSchema} breadcrumbs={[{ name: "Inicio", href: "/" }, { name: "Zonas", href: "/zonas/" }, { name: zona.nombre }]}>
  <main id="contenido-principal">
    <PageHero eyebrow={pagina.data.eyebrow} title={pagina.data.heroTitle} desc={pagina.data.heroDescription} stats={pagina.data.heroStats} ctas={[{ href: `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(`Hola INFLABLEE, quiero rentar inflables en ${zona.nombre}.`)}`, label: pagina.data.primaryCta, variant: "primary" }, { href: pagina.data.secondaryHref, label: pagina.data.secondaryCta, variant: "outline" }]} />
    {detalle ? <section class="zonas-section"><div class="container"><SectionHeader title={pagina.data.sectionTitle} subtitle={pagina.data.sectionDescription} /><div class="zonas-grid" style="margin-top:var(--spacing-xl);">{places.map((place) => <div class={`zona-card${place.destacada ? " zona-card--destacada" : ""}`}><div class="zona-card__header"><span class="zona-card__nombre">{place.nombre}</span>{place.destacada && <span class="zona-card__prioridad">Zona prioritaria</span>}</div>{place.colonias.length > 0 && <p class="zona-card__alcaldias">{place.colonias.join(" · ")}</p>}<a href={`https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(`Hola INFLABLEE, quiero rentar inflables en ${place.nombre}.`)}`} class="zona-card__cta" target="_blank" rel="noopener">Cotizar en {place.nombre} →</a></div>)}</div></div></section> : <section class="seccion"><div class="container"><SectionHeader title={pagina.data.sectionTitle} subtitle={pagina.data.sectionDescription} />{zona.alcaldias.length > 0 && <div class="zona-bloque"><h3 class="zona-bloque__title">Ciudad de México</h3><ul class="zona-bloque__list">{zona.alcaldias.map((alcaldia) => <li><a href="/zonas/cdmx/" class="zona-bloque__link">{alcaldia}</a></li>)}</ul></div>}{zona.municipios.length > 0 && <div class="zona-bloque"><h3 class="zona-bloque__title">Estado de México</h3><ul class="zona-bloque__list">{zona.municipios.map((municipio) => <li><a href="/zonas/estado-de-mexico/" class="zona-bloque__link">{municipio}</a></li>)}</ul></div>}</div></section>}
    {!detalle && <section class="seccion seccion--alt"><div class="container"><SectionHeader title={`Qué se renta más en la ${zona.nombre}`} subtitle="El catálogo completo entrega en toda la zona; estas son las categorías por las que más preguntan." /><div class="zona-cats">{CATEGORIAS.map((categoria) => <a href={`/inflables/${categoria.slug}/`} class="zona-cat"><span>{categoria.emoji}</span><strong>{categoria.label}</strong></a>)}</div></div></section>}
    <section class="zone-copy"><div class="container markdown-seo"><Content /></div></section>
    <CTABanner title={pagina.data.ctaTitle} subtitle={pagina.data.ctaDescription} secondaryText={pagina.data.ctaSecondaryCta} secondaryHref={pagina.data.ctaSecondaryHref} /><LeadCapture />
  </main>
</PageLayout>

<style>.zona-cats{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:1rem;margin-top:var(--spacing-xl)}.zona-cat{display:flex;flex-direction:column;gap:.5rem;align-items:center;padding:var(--spacing-lg);background:#fff;border:1px solid var(--color-border);border-radius:var(--border-radius-lg);color:var(--color-secondary);text-align:center}.zona-bloque{margin-top:var(--spacing-xl)}.zona-bloque__title{font-size:var(--font-size-sm);font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--color-text-light);margin-bottom:.75rem}.zona-bloque__list{display:flex;flex-wrap:wrap;gap:.5rem;list-style:none;padding:0;margin:0}.zona-bloque__link{display:inline-block;padding:.45rem .9rem;border:1px solid var(--color-border);border-radius:999px;background:var(--color-white);font-size:var(--font-size-sm);font-weight:600;color:var(--color-secondary)}.zona-card__prioridad{font-size:.65rem;font-weight:700;background:#e8f5e9;color:#16a34a;padding:.2rem .5rem;border-radius:50px}.zone-copy{padding:var(--spacing-3xl) 0;background:var(--color-accent)}.markdown-seo :global(h2){font-size:clamp(1.4rem,2.5vw,2rem);font-weight:900;color:var(--color-secondary);margin:1.5rem 0 1rem}.markdown-seo :global(p){color:var(--color-text-light);line-height:1.7}</style>
