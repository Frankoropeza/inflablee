---
import PageLayout from "@/layouts/PageLayout.astro";
import PageHero from "@/components/PageHero.astro";
import BlogCard from "@/components/BlogCard.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<PageLayout
  title="Blog — Consejos para Fiestas e Inflables | INFLABLEE"
  description="Artículos, consejos y guías sobre fiestas infantiles, renta de inflables y organización de eventos."
  breadcrumbs={[{ name: "Inicio", href: "/" }, { name: "Blog" }]}
>
  <main id="contenido-principal">
    <PageHero
      eyebrow="Blog INFLABLEE"
      title="Consejos para fiestas y eventos"
      desc="Guías, tips y todo lo que necesitas saber para organizar el mejor evento con inflables."
    />

    <section style="padding:var(--spacing-4xl) 0;">
      <div class="container">
        {posts.length > 0 ? (
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:var(--spacing-xl);">
            {posts.map(post => (
              <BlogCard
                title={post.data.title}
                slug={post.slug}
                description={post.data.description}
                pubDate={post.data.pubDate}
                category={post.data.category || "General"}
              />
            ))}
          </div>
        ) : (
          <p style="text-align:center;color:var(--color-text-light);padding:var(--spacing-3xl) 0;">
            Próximamente publicaremos artículos sobre fiestas e inflables. ¡Vuelve pronto!
          </p>
        )}
      </div>
    </section>
  </main>
</PageLayout>
