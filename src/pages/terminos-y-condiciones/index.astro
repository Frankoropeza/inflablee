---
import { getCollection, render } from "astro:content";
import PageLayout from "@/layouts/PageLayout.astro";
const pagina = (await getCollection("paginas")).find((entry) => entry.id === "terminos-y-condiciones");
if (!pagina) throw new Error("Falta el contenido de términos.");
const { Content } = await render(pagina);
---

<PageLayout title={pagina.data.title} description={pagina.data.description} breadcrumbs={[{ name: "Inicio", href: "/" }, { name: "Términos y condiciones" }]}>
  <main id="contenido-principal"><article class="legal"><div class="container"><h1 class="legal__title">Términos y condiciones de la renta</h1><Content /><p class="legal__back"><a href="/">&larr; Volver al inicio</a></p></div></article></main>
</PageLayout>
