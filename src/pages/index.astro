---
import PageLayout from "@/layouts/PageLayout.astro";
import InflableCard from "@/components/InflableCard.astro";
import CTABanner from "@/components/CTABanner.astro";
import FaqItem from "@/components/FaqItem.astro";
import BlogCard from "@/components/BlogCard.astro";
import { SITE } from "@/data/site";
import { getCollection } from "astro:content";

const allInflables = await getCollection("inflables");
const inflables = allInflables
  .filter(i => i.data.disponible)
  .sort((a, b) => a.data.order - b.data.order);

const blogPosts = (await getCollection("blog"))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const waBase = `https://wa.me/${SITE.whatsapp}`;
const waCotizar = `${waBase}?text=${encodeURIComponent("Hola INFLABLEE, quiero cotizar inflables para mi evento 🎈")}`;
const waCatalogo = `${waBase}?text=${encodeURIComponent("Hola INFLABLEE, me gustaría ver el catálogo completo de inflables.")}`;

const testimonios = [
  { name: "Laura Martínez", inicial: "L", color: "#FF4B1F", text: "El castillo inflable llegó puntual, limpio y los niños la pasaron increíble. Totalmente recomendados. El supervisor fue super atento con los niños todo el tiempo.", event: "Cumpleaños infantil · Coyoacán", stars: 5 },
  { name: "Carlos Ramírez", inicial: "C", color: "#0077CC", text: "Rentamos el barco pirata para el cumpleaños de mi hijo. Instalación rapidísima, personal muy amable y el inflable en perfectas condiciones. Ya los contratamos por tercera vez.", event: "Fiesta temática pirata · Naucalpan", stars: 5 },
  { name: "Ana García", inicial: "A", color: "#7C3AED", text: "Contratamos la pista extremo para el día del niño en la empresa. Los niños felices, los papás tranquilos y el personal muy profesional. Los recomendaría 100%.", event: "Evento corporativo · Santa Fe", stars: 5 },
  { name: "Roberto Sánchez", inicial: "R", color: "#059669", text: "La pista de obstáculos fue el hit de la kermés escolar. 200 niños la disfrutaron todo el día sin ningún problema. Precio justo y servicio de primera.", event: "Kermés escolar · Iztapalapa", stars: 5 },
];

const faqs = [
  { id: "f1", question: "¿Cuánto cuesta rentar un brincalín en CDMX?", answer: "El precio de renta de un brincalín en CDMX va de $800 a $3,000 MXN dependiendo del modelo y tamaño — con entrega, instalación, supervisor y retiro incluidos, sin costos ocultos. Mini castillo (2×2 m): desde $800 MXN. Castillo estándar (3×3 m): desde $1,200 MXN. Barco Pirata (5×4 m): desde $2,500 MXN. Pista de obstáculos (8×3 m): desde $3,000 MXN. Todos los precios incluyen IVA." },
  { id: "f2", question: "¿Qué incluye la renta de inflables?", answer: "La renta incluye el inflable, soplador eléctrico, lonas de anclaje, lona de piso protectora, supervisor certificado durante todo el evento, seguro de responsabilidad civil, sanitización previa y retiro al finalizar — sin cargo adicional. Solo necesitas un contacto eléctrico de 110 V / 15 A a máximo 10 metros del área de instalación." },
  { id: "f3", question: "¿Los inflables son seguros para los niños?", answer: "Sí. Cada inflable pasa por verificación de 15 puntos antes de salir al evento: presión de operación (máx. 3.5 PSI, dentro del estándar ASTM F2374), resistencia de costuras, sistema de anclaje de 6 a 10 puntos y funcionamiento del soplador. Además incluye supervisor certificado en sitio y seguro de responsabilidad civil. Registro de accidentes en 523 eventos: cero." },
  { id: "f4", question: "¿Cuánto espacio necesito para un castillo inflable?", answer: "Un mini castillo (2×2 m) necesita un área libre de 3×3 m. Un castillo estándar (3×3 m) necesita 4.2×4.2 m. El Barco Pirata (5×4 m) requiere 6.6×5.6 m. La Pista Extremo (8×3 m) necesita 10×5 m. En todos los casos necesitas al menos 60 cm de perímetro de seguridad libre de obstáculos en todos los lados. Te asesoramos con medidas exactas al cotizar." },
  { id: "f5", question: "¿Qué pasa si llueve el día de mi evento?", answer: "Si llueve el día de tu evento y las condiciones no permiten el uso seguro del inflable, puedes reagendar sin costo o recibir el reembolso total del anticipo. La decisión la tomamos juntos basándonos en el pronóstico del SMN (Servicio Meteorológico Nacional). Si la lluvia es ligera y el área está techada, el servicio puede continuar con precauciones adicionales." },
  { id: "f6", question: "¿Con cuánta anticipación debo reservar el inflable?", answer: "En temporada alta (abril, mayo, julio, agosto y diciembre), los fines de semana se reservan hasta con 3 semanas de anticipación. En temporada normal, 5 a 7 días son suficientes. Los sábados desde las 12 PM y los domingos completos son las franjas más solicitadas. Si tu evento es de último momento, escríbenos — a veces tenemos cancelaciones que liberan fechas." },
  { id: "f7", question: "¿Aceptan pago con tarjeta o transferencia?", answer: "Sí. Aceptamos efectivo, transferencia SPEI, tarjeta de débito Visa/Mastercard y tarjeta de crédito. Para reservar se requiere un anticipo del 30% del total (no 50%) — el resto se liquida el día del evento, antes de la instalación. No cobramos comisión por pago con tarjeta." },
  { id: "f8", question: "¿Hacen entregas en toda la CDMX y Estado de México?", answer: "Cubrimos las 16 alcaldías de CDMX y los principales municipios del Estado de México — Ecatepec, Nezahualcóyotl, Naucalpan, Tlalnepantla, Chimalhuacán, Texcoco, Tultitlán y Cuautitlán — sin costo adicional de transporte en zona de cobertura. ¿Tu colonia no aparece? Escríbenos por WhatsApp y verificamos cobertura al instante." },
];

const zonas = [
  "Coyoacán", "Iztapalapa", "Benito Juárez", "Gustavo A. Madero",
  "Tlalpan", "Xochimilco", "Álvaro Obregón", "Miguel Hidalgo",
  "Ecatepec", "Naucalpan", "Nezahualcóyotl", "Tlalnepantla",
  "Chimalhuacán", "Texcoco", "Tultitlán", "Cuautitlán"
];
---

<PageLayout
  title="Renta de Inflables CDMX · Desde $800 con Instalación | INFLABLEE"
  description="Castillos inflables, toboganes y brincalines para fiestas en CDMX y Estado de México. Entrega, instalación y supervisor incluidos. Cotiza en WhatsApp."
  pageType="home"
  schema={{
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "INFLABLEE",
    "description": "Empresa de renta de inflables para fiestas en CDMX y Estado de México. Castillos inflables, toboganes acuáticos, pistas de obstáculos y brincalines con entrega e instalación incluida.",
    "url": "https://inflablee.com",
    "priceRange": "$800-$3000 MXN",
    "currenciesAccepted": "MXN",
    "paymentAccepted": "Efectivo, Transferencia SPEI, Tarjeta de débito, Tarjeta de crédito",
    "areaServed": [
      {"@type": "City", "name": "Ciudad de México"},
      {"@type": "AdministrativeArea", "name": "Estado de México"}
    ],
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Catálogo de Inflables INFLABLEE",
      "itemListElement": [
        {"@type": "Offer", "itemOffered": {"@type": "Product", "name": "Mini Castillo Inflable"}, "price": "800", "priceCurrency": "MXN"},
        {"@type": "Offer", "itemOffered": {"@type": "Product", "name": "Castillo de Princesas"}, "price": "1200", "priceCurrency": "MXN"},
        {"@type": "Offer", "itemOffered": {"@type": "Product", "name": "Castillo Dragones Rojos"}, "price": "1200", "priceCurrency": "MXN"},
        {"@type": "Offer", "itemOffered": {"@type": "Product", "name": "Barco Pirata"}, "price": "2500", "priceCurrency": "MXN"},
        {"@type": "Offer", "itemOffered": {"@type": "Product", "name": "Castillo Blanco Premium"}, "price": "2800", "priceCurrency": "MXN"},
        {"@type": "Offer", "itemOffered": {"@type": "Product", "name": "Pista Extremo"}, "price": "3000", "priceCurrency": "MXN"}
      ]
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.9",
      "reviewCount": "127",
      "bestRating": "5"
    }
  }}
>
  <main id="contenido-principal">

    <!-- ═══════════════════════════════════ HERO ═══════════════════════════════════ -->
    <section class="hero" aria-label="Inicio">
      <div class="container hero__container">

        <!-- Columna izquierda -->
        <div class="hero__left">
          <div class="hero__badge">
            <span class="hero__badge-dot"></span>
            Entrega e instalación GRATIS · CDMX y Estado de México
          </div>

          <h1 class="hero__title">
            Renta de <span class="hero__title-highlight">Inflables</span><br/>
            para Fiestas en CDMX
          </h1>

          <p class="hero__desc">
            Castillos, toboganes, barcos pirata y pistas de obstáculos para cumpleaños,
            kermeses y eventos corporativos. Todo incluido: entrega, instalación y supervisor capacitado.
          </p>

          <div class="hero__ctas">
            <a href={waCotizar} class="hero__btn-wa" target="_blank" rel="noopener">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              Cotizar por WhatsApp
            </a>
            <a href="#catalogo" class="hero__btn-outline">
              Ver catálogo
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </a>
          </div>

        </div>

        <!-- Columna derecha: SEO content -->
        <div class="hero__right">
          <div class="hero__seo">
            <div class="hero__seo-block">
              <p class="hero__seo-title"><strong>RENTA DE INFLABLES EN CDMX · PRECIOS DESDE $800 MXN</strong></p>
              <p class="hero__seo-text">
                8 modelos de brincalines, castillos y toboganes disponibles este fin de semana. Castillos desde 2×2 m (ideal para departamentos y patios chicos) hasta circuitos de obstáculos de 8 metros. Cada inflable incluye soplador eléctrico, lonas de anclaje, <strong>supervisor certificado y seguro de responsabilidad civil</strong> — sin costos ocultos. El precio que aparece en la ficha es el precio final, con IVA incluido.
              </p>
            </div>
            <div class="hero__seo-block">
              <p class="hero__seo-title"><strong>523 EVENTOS EN CDMX Y EDOMEX ENTRE 2021 Y 2025 · 0 ACCIDENTES</strong></p>
              <p class="hero__seo-text">
                En alcaldías como Coyoacán, Benito Juárez, Tlalpan, Xochimilco e Iztapalapa, y en municipios como Nezahualcóyotl, Ecatepec y Naucalpan. Cada inflable pasa por <strong>verificación de presión, costuras, anclajes y válvula</strong> antes de salir al evento. Depósito de solo el 30% para apartar tu fecha. Si llueve, reagendamos sin costo o devolvemos el anticipo completo.
              </p>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- ════════════════════════════ CATÁLOGO ════════════════════════════ -->
    <section class="seccion seccion--alt" id="catalogo">
      <div class="container">
        <div class="section-header-split">
          <div class="section-header-split__left">
            <span class="section-badge">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              Catálogo completo
            </span>
            <h2 class="section-title">Elige tu inflable perfecto</strong></p>
            <p class="section-subtitle">8 modelos disponibles para todos los presupuestos y tipos de evento. Entrega e instalación siempre incluidas.</p>
          </div>
          <div class="section-header-split__right">
            <p class="section__seo-text">Contamos con castillos inflables desde 2×2 m (ideal para departamentos y patios chicos) hasta circuitos de obstáculos de 8 metros. Cada inflable incluye soplador eléctrico, lonas de anclaje, supervisor certificado y seguro de responsabilidad civil — sin costos ocultos. El precio que aparece en la ficha es el precio final, con IVA incluido.</p>
            <p class="section__seo-text">En temporada alta (abril, mayo, julio, agosto y diciembre) nuestros inflables se reservan hasta con 3 semanas de anticipación. Los sábados a partir de las 12 PM y los domingos completos son las franjas más solicitadas. Consulta disponibilidad hoy mismo — sin compromiso.</p>
          </div>
        </div>

        {inflables.length > 0 ? (
          <div class="inflables-grid">
            {inflables.map(i => (
              <InflableCard
                title={i.data.title}
                descripcion={i.data.descripcion}
                categoria={i.data.categoria}
                precio_desde={i.data.precio_desde}
                capacidad={i.data.capacidad}
                medidas={i.data.medidas}
                tiempo_instalacion={i.data.tiempo_instalacion}
                slug={i.slug}
                imagen={i.data.imagen}
                disponible={i.data.disponible}
                featured={i.data.featured}
              />
            ))}
          </div>
        ) : (
          <p style="text-align:center;color:var(--color-text-light);padding:3rem 0;">
            Catálogo cargando... Contáctanos por WhatsApp para ver disponibilidad.
          </p>
        )}

        <div style="text-align:center;margin-top:var(--spacing-2xl);">
          <a href={waCatalogo} class="btn btn--outline" target="_blank" rel="noopener">
            Ver todos los inflables por WhatsApp →
          </a>
        </div>

      </div>
    </section>

    <!-- ════════════════════════════ CÓMO FUNCIONA ════════════════════════════ -->
    <section class="seccion como-funciona">
      <div class="container">
        <div class="section-header-split">
          <div class="section-header-split__left">
            <span class="section-badge">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
              Simple y rápido
            </span>
            <h2 class="section-title">¿Cómo funciona la renta?</strong></p>
            <p class="section-subtitle">En 3 pasos tienes tu inflable listo para la fiesta. Sin complicaciones, sin sorpresas.</p>
          </div>
          <div class="section-header-split__right">
            <p class="section__seo-text">Nuestro equipo atiende por WhatsApp de 8 AM a 10 PM todos los días, incluyendo fines de semana y días festivos. En el primer mensaje te confirmamos disponibilidad; en el segundo, el precio final sin letra chica; en el tercero, el adelanto del 30% asegura tu fecha. Sin formularios, sin llamadas interminables, sin esperas de 24 horas.</p>
            <p class="section__seo-text">Llegamos 60 minutos antes del inicio con todo el equipo: inflable, soplador, lonas de anclaje y herramientas de instalación. La instalación estándar toma entre 15 y 40 minutos dependiendo del modelo. Al terminar el evento, el equipo regresa, desinfla, dobla, carga y se va — sin dejarte trabajo de limpieza ni desmontaje.</p>
          </div>
        </div>

        <div class="pasos">
          <div class="pasos__conector" aria-hidden="true"></div>

          <div class="paso">
            <div class="paso__num" aria-hidden="true">01</div>
            <div class="paso__icon-wrap">
              <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
            </div>
            <h3 class="paso__title">Cotiza por WhatsApp</h3>
            <p class="paso__desc">Cuéntanos tu fecha, número de niños y tipo de evento. En minutos te enviamos opciones y disponibilidad.</p>
            <a href={waCotizar} class="paso__link" target="_blank" rel="noopener">Cotizar ahora →</a>
          </div>

          <div class="paso">
            <div class="paso__num" aria-hidden="true">02</div>
            <div class="paso__icon-wrap">
              <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            </div>
            <h3 class="paso__title">Agendamos tu fecha</h3>
            <p class="paso__desc">Confirmas tu reserva con un anticipo del 50%. Tu fecha queda bloqueada y recibes confirmación inmediata.</p>
          </div>

          <div class="paso">
            <div class="paso__num" aria-hidden="true">03</div>
            <div class="paso__icon-wrap">
              <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </div>
            <h3 class="paso__title">Llegamos y montamos</h3>
            <p class="paso__desc">El día del evento llegamos 1 hora antes, instalamos todo y supervisamos para que disfrutes sin preocupaciones.</p>
          </div>
        </div>

      </div>
    </section>

    <!-- ════════════════════════════ POR QUÉ ELEGIRNOS ════════════════════════════ -->
    <section class="seccion seccion--alt porquenos">
      <div class="container">
        <div class="section-header-split">
          <div class="section-header-split__left">
            <span class="section-badge">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
              Confianza comprobada
            </span>
            <h2 class="section-title">¿Por qué elegirnos?</strong></p>
            <p class="section-subtitle">Más de 500 familias y empresas en CDMX ya confían en INFLABLEE. Aquí está el por qué.</p>
          </div>
          <div class="section-header-split__right">
            <p class="section__seo-text">Cada unidad se inspecciona con lista de 15 puntos derivada de las recomendaciones de la ASTM F2374 (estándar internacional para inflables de entretenimiento). Verificamos presión de operación (no mayor a 3.5 PSI), resistencia de costuras laterales, sistema de anclaje de 6 a 10 puntos y funcionamiento del soplador antes de carga. El resultado: cero accidentes en 523 eventos operados entre 2021 y 2025.</p>
            <p class="section__seo-text">Usamos solución desinfectante al amonio cuaternario (segura para contacto infantil) en todas las superficies internas y externas. El inflable sale sellado en bolsa de protección para que llegue a tu evento en las mismas condiciones en que salió del almacén. Si al desempacarlo no cumple tus expectativas de limpieza, te reembolsamos el depósito completo sin preguntas.</p>
          </div>
        </div>

        <div class="razones-grid">
          <div class="razon">
            <div class="razon__icon" style="background:rgba(255,75,31,0.12);color:#FF4B1F;">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 3h15v13H1zM16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            </div>
            <div class="razon__content">
              <h3>Entrega e instalación incluida</h3>
              <p>Sin costos ocultos. Llevamos todo, instalamos y recogemos al terminar el evento.</p>
            </div>
          </div>

          <div class="razon">
            <div class="razon__icon" style="background:rgba(34,197,94,0.12);color:#16a34a;">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
            </div>
            <div class="razon__content">
              <h3>Sanitización antes de cada evento</h3>
              <p>Limpiamos y desinfectamos cada inflable con productos seguros para niños antes de entregarlo.</p>
            </div>
          </div>

          <div class="razon">
            <div class="razon__icon" style="background:rgba(0,119,204,0.12);color:#0077CC;">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>
            </div>
            <div class="razon__content">
              <h3>Supervisor capacitado incluido</h3>
              <p>Un profesional estará presente durante todo el evento para garantizar la seguridad de los niños.</p>
            </div>
          </div>

          <div class="razon">
            <div class="razon__icon" style="background:rgba(124,58,237,0.12);color:#7C3AED;">
