---
import PageLayout from "@/layouts/PageLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import CTABanner from "@/components/CTABanner.astro";
import LeadCapture from "@/components/LeadCapture.astro";
import { getCollection } from "astro:content";
import { getPackageCards } from "@/lib/packages";
import { SITE } from "@/data/site";
import { categoriaLabel } from "@/data/categorias";
import { faqSchema, FAQS_GENERALES } from "@/data/faq";
import "@/styles/precios.css";

const inflables = (await getCollection("inflables")).sort(
  (a, b) => a.data.precio_desde - b.data.precio_desde
);
const paquetes = await getPackageCards("paquetes");

const precioMin = Math.min(...inflables.map(i => i.data.precio_desde));
const precioMax = Math.max(...inflables.map(i => i.data.precio_desde));

const mxn = (n: number) => `$${n.toLocaleString("es-MX")} MXN`;

// Lista de precios en schema.org, construida desde el mismo catálogo que ve el visitante.
const listaSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Precios de renta de inflables INFLABLEE",
  "itemListElement": inflables.map((i, idx) => ({
    "@type": "ListItem",
    "position": idx + 1,
    "item": {
      "@type": "Product",
      "name": i.data.title,
      "category": categoriaLabel(i.data.categoria),
      "url": new URL(`/inflables/${i.id}`, SITE.url).href,
      ...(i.data.imagen ? { "image": new URL(i.data.imagen, SITE.url).href } : {}),
      "offers": {
        "@type": "Offer",
        "price": String(i.data.precio_desde),
        "priceCurrency": "MXN",
        "availability": i.data.disponible
          ? "https://schema.org/InStock"
          : "https://schema.org/OutOfStock",
        "url": new URL(`/inflables/${i.id}`, SITE.url).href,
      },
    },
  })),
};
---

<PageLayout
  title={`Precios de Inflables en CDMX — Desde ${mxn(precioMin)} | INFLABLEE`}
  description={`Lista de precios de renta de inflables en CDMX y Edomex: de ${mxn(precioMin)} a ${mxn(precioMax)} por modelo, con medidas, edades y altura libre.`}
  schema={[listaSchema, faqSchema(FAQS_GENERALES)]}
  breadcrumbs={[{ name: "Inicio", href: "/" }, { name: "Precios" }]}
>
  <main id="contenido-principal">
    <PageHero
      eyebrow="Lista de precios"
      title="Precios de renta de inflables\n<span>sin costos escondidos</span>"
      desc={`De ${mxn(precioMin)} a ${mxn(precioMax)} según el modelo. Consulta medidas, altura libre y condiciones de entrega por zona.`}
      ctas={[
        { href: "#tabla-precios", label: "Ver la tabla", variant: "primary" },
        { href: `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent("Hola INFLABLEE, quiero confirmar el precio para mi fecha.")}`, label: "Confirmar mi fecha", variant: "outline" },
      ]}
    />

    <section class="seccion" id="tabla-precios">
      <div class="container">
        <SectionHeader
          title="Precio por modelo"
          subtitle="Precio por evento de 4 a 6 horas, ordenado de menor a mayor. Las medidas son largo × ancho × alto del inflable; la altura libre indica lo necesario sobre el piso para instalarlo."
        />

        <div class="precios-tabla-wrap">
          <table class="precios-tabla">
            <caption class="precios-tabla__caption">
              Precio, medidas, edades, altura libre e interiores de los inflables en renta.
            </caption>
            <thead>
              <tr>
                <th scope="col">Inflable</th>
                <th scope="col">Precio por evento</th>
                <th scope="col">Medidas</th>
                <th scope="col">Altura libre</th>
                <th scope="col">Edades</th>
                <th scope="col">Bajo techo</th>
              </tr>
            </thead>
            <tbody>
              {inflables.map(i => (
                <tr>
                  <th scope="row">
                    <a href={`/inflables/${i.id}`}>{i.data.title}</a>
                    {!i.data.disponible && <span class="precios-tabla__nota">No disponible</span>}
                  </th>
                  <td class="precios-tabla__precio">{mxn(i.data.precio_desde)}</td>
                  <td>{i.data.medidas}</td>
                  <td>{i.data.altura_libre}</td>
                  <td>{i.data.edades}</td>
                  <td>{i.data.interiores ? "Sí" : "No"}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="precios-incluye-grid">
          <div>
            <h3>¿Qué incluye el precio?</h3>
            <ul class="precios-incluye">{SITE.comercial.incluye.map((item) => <li>{item}</li>)}</ul>
          </div>
          <div>
            <h3>¿Qué se cobra aparte?</h3>
            <ul class="precios-incluye">
              <li><strong>Envío por zona:</strong> {SITE.comercial.envio.sinCosto} {SITE.comercial.envio.cdmx} {SITE.comercial.envio.edomex}</li>
              <li><strong>IVA:</strong> {SITE.comercial.iva}</li>
              <li>{SITE.comercial.anticipo}</li>
            </ul>
          </div>
        </div>
        <h3 class="precios-requisitos__title">Requisitos del cliente</h3>
        <ul class="precios-incluye">{SITE.comercial.requisitos.map((item) => <li>{item}</li>)}</ul>
        <p class="precios-nota">{SITE.comercial.supervisor}</p>
      </div>
    </section>

    <section class="seccion seccion--alt">
      <div class="container">
        <SectionHeader
          title="Paquetes"
          subtitle="Combinaciones armadas para los eventos que más nos piden."
        />
        <div class="precios-paquetes">
          {paquetes.map(p => (
            <article class="precios-paquete">
              <h3 class="precios-paquete__title">{p.title}</h3>
              <p class="precios-paquete__price">{p.price}</p>
              <p class="precios-paquete__desc">{p.description}</p>
              {p.includes.length > 0 && (
                <ul class="precios-paquete__list">
                  {p.includes.map(item => <li>{item}</li>)}
                </ul>
              )}
              <a
                href={`https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(`Hola INFLABLEE, me interesa el ${p.title}. ¿Está disponible?`)}`}
                class="btn btn--primary btn--sm"
                target="_blank"
                rel="noopener"
              >
                Consultar disponibilidad
              </a>
            </article>
          ))}
        </div>
        <p class="precios-nota">
          <a href="/servicios/paquetes">Ver el detalle de cada paquete &rarr;</a>
        </p>
      </div>
    </section>

    <section class="seccion">
      <div class="container">
        <div class="section__seo" style="margin-top:0;padding-top:0;border-top:none;">
          <div class="section__seo-block">
            <p class="section__seo-label">QUÉ MUEVE EL PRECIO</p>
            <h2 class="section__seo-title">Tres cosas cambian la tarifa: el modelo, la duración y la zona</h2>
            <p class="section__seo-text">
              El modelo manda: el Castillo Baby mide 2.5 × 2 × 2 m y Extremo mide 8 × 4.5 × 3.50 m.
              La zona también cambia el total: {SITE.comercial.envio.sinCosto} {SITE.comercial.envio.cdmx}
              {" "}{SITE.comercial.envio.edomex}
            </p>
            <p class="section__seo-text">
              {SITE.comercial.anticipo} {SITE.comercial.iva} Si quieres el número exacto para tu fecha,
              <a href="/cotizar"> manda los datos de tu evento</a>
              o revisa primero las <a href="/preguntas-frecuentes">preguntas frecuentes</a>.
            </p>
          </div>
        </div>
      </div>
    </section>

    <LeadCapture />

    <CTABanner
      title="¿Te confirmamos el precio de tu fecha?"
      subtitle="Mándanos la fecha, la zona y el espacio que tienes. Te devolvemos el precio cerrado."
      secondaryText="Ver preguntas frecuentes"
      secondaryHref="/preguntas-frecuentes"
    />
  </main>
</PageLayout>
