---
import PageLayout from "@/layouts/PageLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import PricingCard from "@/components/PricingCard.astro";
import CTABanner from "@/components/CTABanner.astro";
import LeadCapture from "@/components/LeadCapture.astro";
import MarkdownSeo from "@/components/MarkdownSeo.astro";
import { SITE } from "@/data/site";
import { getPackageCards } from "@/lib/packages";
const paquetes = await getPackageCards("escolares");
---

<PageLayout
  title="Inflables para Kermeses y Eventos Escolares CDMX | INFLABLEE"
  description="Inflables para kermeses, días del niño y festivales escolares en CDMX y Estado de México. Consulta opciones para eventos de gran escala."
  breadcrumbs={[{ name: "Inicio", href: "/" }, { name: "Servicios", href: "/servicios/" }, { name: "Eventos Escolares" }]}
>
  <main id="contenido-principal">
    <PageHero
      eyebrow="Eventos escolares"
      title="Kermeses y festivales\n<span>con inflables profesionales</span>"
      desc="Cotiza un evento personalizado si necesitas cinco o más inflables simultáneos."
      ctas={[
        { href: `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent("Hola INFLABLEE, quiero cotizar inflables para un evento escolar.")}`, label: "Cotizar evento", variant: "primary" },
        { href: "/inflables/pistas-obstaculos/", label: "Ver pistas", variant: "outline" },
      ]}
    />

    <section style="padding:var(--spacing-3xl) 0;">
      <div class="container">
        <SectionHeader
          title="Todo lo que necesitas para tu evento escolar"
          subtitle="Nos encargamos de toda la logística para que tú solo te preocupes por disfrutar."
        />
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:1.25rem;margin-top:var(--spacing-xl);">
          {[
            { icon: "📋", title: "Evento personalizado", desc: "Para cinco o más inflables simultáneos, cotizamos la logística de acuerdo con tu evento." },
            { icon: "🔌", title: "Requisitos del lugar", desc: "Se requiere corriente de 110 V a menos de 20 m y superficie plana, despejada y sin objetos punzantes." },
            { icon: "👤", title: "Supervisión adulta", desc: "Una persona adulta debe supervisar durante todo el evento." },
            { icon: "📄", title: "Facturación disponible", desc: "La facturación está disponible para el evento personalizado." },
          ].map(r => (
            <div class="svc-card">
              <span class="svc-card__icon">{r.icon}</span>
              <h3 class="svc-card__title">{r.title}</h3>
              <p class="svc-card__desc">{r.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section style="background:var(--color-accent);padding:var(--spacing-3xl) 0;">
      <div class="container">
        <SectionHeader
          title="Paquetes para eventos escolares"
          subtitle="Precios especiales para instituciones educativas. Sin compromiso al cotizar."
        />
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:var(--spacing-xl);margin-top:var(--spacing-xl);">
          {paquetes.map(p => (
            <PricingCard
              title={p.title}
              price={p.price}
              description={p.description}
              includes={p.includes}
              featured={p.featured}
              badge={p.badge}
              ctaHref={`https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(`Hola INFLABLEE, me interesa el ${p.title} para mi evento escolar.`)}`}
            />
          ))}
        </div>
      </div>
    </section>

    <MarkdownSeo id="seo-eventos-escolares" />

    <CTABanner
      title="¿Cuándo es tu kermés o festival escolar?"
      subtitle="El 30 de abril se reserva desde febrero. No dejes para después tu evento de Día del Niño."
    />
    <LeadCapture />
  </main>
</PageLayout>
