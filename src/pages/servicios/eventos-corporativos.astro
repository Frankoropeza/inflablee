---
import PageLayout from "@/layouts/PageLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import CTABanner from "@/components/CTABanner.astro";
import LeadCapture from "@/components/LeadCapture.astro";
import MarkdownSeo from "@/components/MarkdownSeo.astro";
import { SITE } from "@/data/site";
---

<PageLayout
  title="Inflables para Eventos Corporativos en CDMX | INFLABLEE"
  description="Renta de inflables para eventos corporativos y convivencias en CDMX y Estado de México. Consulta los modelos publicados."
  breadcrumbs={[{ name: "Inicio", href: "/" }, { name: "Servicios", href: "/servicios/" }, { name: "Eventos Corporativos" }]}
>
  <main id="contenido-principal">
    <PageHero
      eyebrow="Eventos corporativos"
      title="Inflables para\n<span>team building y convivencias</span>"
      desc="Consulta el catálogo disponible y solicita una cotización personalizada si requieres cinco o más inflables simultáneos."
      ctas={[
        { href: `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent("Hola INFLABLEE, quiero cotizar inflables para un evento corporativo.")}`, label: "Cotizar evento", variant: "primary" },
        { href: "/inflables/juegos-interactivos/", label: "Ver juegos interactivos", variant: "outline" },
      ]}
    />

    <section style="padding:var(--spacing-3xl) 0;">
      <div class="container">
        <SectionHeader
          title="Actividades para equipos de trabajo"
          subtitle="Los inflables interactivos son perfectos para romper el hielo y fomentar el trabajo en equipo."
        />
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1.25rem;margin-top:var(--spacing-xl);">
          {[
            { icon: "🎈", title: "Catálogo publicado", desc: "Consulta los ocho modelos, sus medidas, edades y altura libre." },
            { icon: "🏃", title: "Pista Extremo", desc: "Modelo de obstáculos para edades de 3 a 12 años; revisa su ficha antes de cotizar." },
            { icon: "📏", title: "Planeación del espacio", desc: "Comparte medidas y condiciones del lugar para confirmar el modelo adecuado." },
            { icon: "🎪", title: "Evento personalizado", desc: "Para cinco o más inflables simultáneos, cotiza con coordinador logístico dedicado." },
          ].map(r => (
            <div class="svc-card">
              <span class="svc-card__icon">{r.icon}</span>
              <h3 class="svc-card__title">{r.title}</h3>
              <p class="svc-card__desc">{r.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section style="background:var(--color-accent);padding:var(--spacing-3xl) 0;">
      <div class="container" style="max-width:860px;">
        <h2 style="font-size:var(--font-size-2xl);font-weight:800;color:var(--color-secondary);margin-bottom:var(--spacing-lg);">Lo que incluye nuestro servicio corporativo</h2>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--spacing-md);">
          {[
            "Entrega a domicilio e instalación de 15 a 30 minutos",
            "Motor inflador y extensión eléctrica",
            "Sanitización antes de cada evento",
            "Recolección al terminar",
            "Envío confirmado según la zona",
            SITE.comercial.iva,
            "Supervisión adulta durante el evento",
            "Coordinador logístico en evento personalizado",
          ].map(item => (
            <div style="display:flex;align-items:center;gap:0.75rem;padding:0.75rem;background:white;border-radius:var(--border-radius);font-size:var(--font-size-sm);color:var(--color-text);">
              <span style="color:var(--color-success);font-weight:700;flex-shrink:0;">✓</span>
              {item}
            </div>
          ))}
        </div>
      </div>
    </section>

    <MarkdownSeo id="seo-eventos-corporativos" />

    <CTABanner
      title="¿Tienes un evento de empresa próximo?"
      subtitle="Cotiza sin compromiso. Respondemos en menos de 2 horas en horario hábil."
    />
    <LeadCapture />
  </main>
</PageLayout>
