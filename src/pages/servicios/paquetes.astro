---
import PageLayout from "@/layouts/PageLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import CTABanner from "@/components/CTABanner.astro";
import LeadCapture from "@/components/LeadCapture.astro";
import MarkdownSeo from "@/components/MarkdownSeo.astro";
import { SITE } from "@/data/site";
import PricingCard from "@/components/PricingCard.astro";
import { getPackageCards } from "@/lib/packages";

const paquetes = await getPackageCards("paquetes");
const paquetesEstandar = paquetes.filter((paquete) => paquete.variant === "standard");
const paquetesEspeciales = paquetes.filter((paquete) => paquete.variant === "pricing");
---

<PageLayout
  title="Paquetes de renta de inflables | INFLABLEE"
  description="Paquetes de renta de inflables para cumpleaños, posadas y eventos corporativos en CDMX y Edomex."
  breadcrumbs={[{ name: "Inicio", href: "/" }, { name: "Servicios", href: "/servicios/" }, { name: "Paquetes" }]}
>
  <main id="contenido-principal">
    <PageHero
      eyebrow="Paquetes y combos"
      title="Más diversión,\n<span>mejor precio</span>"
      desc="Conoce los dos paquetes publicados y la opción para eventos personalizados de cinco o más inflables."
      ctas={[
        { href: `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent("Hola INFLABLEE, quiero cotizar un paquete de inflables.")}`, label: "Ver disponibilidad", variant: "primary" },
        { href: "/inflables/", label: "Ver catálogo completo", variant: "outline" },
      ]}
    />

    {paquetesEstandar.length > 0 && (
      <section style="padding:var(--spacing-3xl) 0;">
        <div class="container">
          <SectionHeader
            title="Paquetes estándar"
            subtitle="Paquetes para distintos tipos de evento."
          />
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:var(--spacing-xl);margin-top:var(--spacing-xl);">
            {paquetesEstandar.map((p) => (
              <div style="background:var(--color-white);border-radius:var(--border-radius-lg);padding:var(--spacing-xl);box-shadow:var(--shadow-sm);border:1.5px solid var(--color-border);">
                <h3 style="font-size:var(--font-size-xl);font-weight:800;color:var(--color-secondary);margin-bottom:var(--spacing-xs);">{p.title}</h3>
                <p style="color: var(--color-primary-text);font-weight:700;font-size:var(--font-size-xl);margin-bottom:var(--spacing-sm);">{p.price}</p>
                <p style="color:var(--color-text-light);margin-bottom:var(--spacing-md);font-size:var(--font-size-sm);">{p.description}</p>
                {p.includes.length > 0 && (
                  <ul style="list-style:none;padding:0;margin-bottom:var(--spacing-lg);">
                    {p.includes.map((item) => (
                      <li style="padding:0.4rem 0;border-bottom:1px solid var(--color-border);font-size:var(--font-size-sm);color:var(--color-text);display:flex;align-items:center;gap:0.5rem;">
                        <span style="color:var(--color-success);font-weight:700;">✓</span> {item}
                      </li>
                    ))}
                  </ul>
                )}
                <a href={`https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(`Hola INFLABLEE, me interesa el ${p.title}.`)}`}
                  class="btn btn--primary" style="width:100%;text-align:center;" target="_blank" rel="noopener">
                  Cotizar paquete
                </a>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    {paquetesEspeciales.length > 0 && (
      <section style="background:var(--color-accent);padding:var(--spacing-3xl) 0;">
        <div class="container">
          <SectionHeader title="Paquetes disponibles" subtitle="Combinaciones reales para distintos tipos de celebración." />
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:var(--spacing-xl);margin-top:var(--spacing-xl);">
            {paquetesEspeciales.map((p) => (
              <PricingCard
                title={p.title}
                price={p.price}
                description={p.description}
                includes={p.includes}
                featured={p.featured}
                badge={p.badge}
                ctaHref={`https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(`Hola INFLABLEE, me interesa el paquete especial: ${p.title}.`)}`}
              />
            ))}
          </div>
        </div>
      </section>
    )}

    <MarkdownSeo id="seo-paquetes" />

    <CTABanner
      title="¿No encuentras el paquete que buscas?"
      subtitle="Armamos paquetes personalizados según tu presupuesto y necesidades. ¡Escríbenos!"
    />
    <LeadCapture />
  </main>
</PageLayout>
