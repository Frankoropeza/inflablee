---
import { getCollection } from "astro:content";
import { getPackageCards } from "@/lib/packages";
import PageLayout from "@/layouts/PageLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import PricingCard from "@/components/PricingCard.astro";
import CTABanner from "@/components/CTABanner.astro";
import LeadCapture from "@/components/LeadCapture.astro";
import { SITE } from "@/data/site";

const tiposEvento = (await getCollection("tiposEvento")).sort((a, b) => a.data.order - b.data.order);
const paquetes = await getPackageCards("servicios");
---

<PageLayout title="Servicios de renta de inflables | INFLABLEE" description="Renta de inflables para fiestas, escuelas y empresas en CDMX. Paquetes con entrega e instalación." breadcrumbs={[{ name: "Inicio", href: "/" }, { name: "Servicios" }]}>
  <main id="contenido-principal">
    <PageHero eyebrow="Nuestros servicios" title="Renta de inflables para\n<span>todo tipo de evento</span>" desc="Fiestas infantiles, eventos escolares, corporativos, posadas y más. Personalizamos cada renta para garantizar la mejor experiencia." ctas={[{ href: `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent("Hola INFLABLEE, quiero cotizar un servicio para mi evento.")}`, label: "Cotizar servicio", variant: "primary" }, { href: "/inflables", label: "Ver catálogo", variant: "outline" }]} />
    <section class="svc-list"><div class="container"><SectionHeader title="¿Para qué tipo de evento buscas inflables?" subtitle="Tenemos soluciones para cada celebración. Desde cumpleaños íntimos hasta kermeses masivas." />
      <div class="svc-list__grid">{tiposEvento.map((tipo) => <div class="svc-card"><div class="svc-card__header"><span class="svc-card__icon">{tipo.data.icon}</span></div><h3 class="svc-card__title">{tipo.data.title}</h3><p class="svc-card__desc">{tipo.data.description}</p><div class="svc-card__tags">{tipo.data.tags.map((tag) => <span class="svc-card__tag">{tag}</span>)}</div><a href={tipo.data.href} class="svc-card__link">Ver servicio →</a></div>)}</div>
    </div></section>
    <section style="background:var(--color-accent);padding:var(--spacing-4xl) 0;" id="paquetes"><div class="container"><SectionHeader title="Paquetes todo incluido" subtitle="Combina inflables y ahorra. Sin sorpresas ni costos ocultos." /><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:var(--spacing-xl);margin-top:var(--spacing-2xl);">{paquetes.map((paquete) => <PricingCard title={paquete.title} price={paquete.price} description={paquete.description} includes={paquete.includes} featured={paquete.featured} badge={paquete.badge} />)}</div><p style="text-align:center;margin-top:var(--spacing-xl);"><a href="/servicios/paquetes" class="btn btn--outline">Ver todos los paquetes</a></p></div></section>
    <section style="padding:var(--spacing-4xl) 0;background:var(--color-secondary);"><div class="container"><SectionHeader title="¿Cómo funciona nuestra renta?" subtitle="Proceso simple en 4 pasos. Nosotros nos encargamos de todo." /><div class="process__grid" style="margin-top:var(--spacing-2xl);">{[
      { num: "1", title: "Cotiza", desc: "Escríbenos por WhatsApp o llena el formulario con los detalles de tu evento." },
      { num: "2", title: "Confirma", desc: "Elige tu inflable o paquete. Apartamos la fecha con un anticipo." },
      { num: "3", title: "Disfruta", desc: "Llegamos 1 hora antes, instalamos todo y supervisamos durante el evento." },
      { num: "4", title: "Descansa", desc: "Al terminar, retiramos y limpiamos todo. Sin preocupaciones para ti." },
    ].map((step) => <div class="process-step"><div class="process-step__num">{step.num}</div><h3 class="process-step__title" style="color:#fff;">{step.title}</h3><p class="process-step__desc">{step.desc}</p></div>)}</div></div></section>
    <CTABanner /><LeadCapture />
  </main>
</PageLayout>
