---
import "@/styles/global.css";
import { SITE } from "@/data/site";

export interface BreadcrumbItem { name: string; href?: string; }

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  pageType?: "home" | "page" | "article";
  noindex?: boolean;
  breadcrumbs?: BreadcrumbItem[];
  schema?: object | object[];
}

const {
  title,
  description,
  canonical = Astro.url.href,
  ogImage = "/img/og-inflablee.jpg",
  pageType = "page",
  noindex = false,
  breadcrumbs,
  schema,
} = Astro.props;

const schemaOrg = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${SITE.url}/org`,
  "name": SITE.name,
  "url": SITE.url,
  "description": SITE.description,
  "telephone": SITE.telHref,
  "email": SITE.email,
  "address": {
    "@type": "PostalAddress",
    "addressCountry": "MX"
  },
  "areaServed": { "@type": "Country", "name": "México" },
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": SITE.telHref,
    "contactType": "sales",
    "areaServed": "MX",
    "availableLanguage": "Spanish"
  }
};

const schemaLocal = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": `${SITE.url}/negocio`,
  "name": "INFLABLEE — Renta de Inflables",
  "url": SITE.url,
  "image": `${SITE.url}/img/og-inflablee.jpg`,
  "description": SITE.description,
  "telephone": SITE.telHref,
  "email": SITE.email,
  "priceRange": "$$",
  "currenciesAccepted": "MXN",
  "paymentAccepted": "Transferencia, Tarjeta, Efectivo",
  "amenityFeature": [
    { "@type": "LocationFeatureSpecification", "name": "Entrega e instalación incluida", "value": true },
    { "@type": "LocationFeatureSpecification", "name": "Supervisión durante el evento", "value": true },
    { "@type": "LocationFeatureSpecification", "name": "Seguro de responsabilidad civil", "value": true }
  ],
  "geo": { "@type": "GeoCoordinates", "latitude": SITE.coords.lat, "longitude": SITE.coords.lng },
  "address": {
    "@type": "PostalAddress",
    "addressCountry": "MX"
  },
  "areaServed": ["México", "CDMX", "Estado de México"]
};

const schemaWebSite = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${SITE.url}/website`,
  "name": SITE.name,
  "url": SITE.url,
  "publisher": { "@id": `${SITE.url}/org` }
};

const schemaBreadcrumb = breadcrumbs ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbs.map((b, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": b.name,
    ...(b.href ? { "item": `${SITE.url}${b.href}` } : {})
  }))
} : null;

const allSchemas: object[] = [schemaOrg, schemaLocal, schemaWebSite];
if (schemaBreadcrumb) allSchemas.push(schemaBreadcrumb);
if (schema) {
  const extra = Array.isArray(schema) ? schema : [schema];
  allSchemas.push(...extra);
}

const ogType = pageType === "article" ? "article" : "website";
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
    />
    <style>html,body{overflow-x:hidden;max-width:100%}*,*::before,*::after{box-sizing:border-box}</style>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"} />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:image" content={`${SITE.url}${ogImage}`} />
    <meta property="og:locale" content="es_MX" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE.url}${ogImage}`} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#FF4B1F" />

    {allSchemas.map(s => (
      <script type="application/ld+json" set:html={JSON.stringify(s, null, 0)} />
    ))}
  </head>
  <body>
    <slot />
  </body>
</html>

<script>
  const hamburger = document.getElementById('hamburger');
  const mobileNav = document.getElementById('mobile-nav');
  const overlay = document.getElementById('mobile-overlay');

  function setNavState(open: boolean) {
    mobileNav?.classList.toggle('mobile-nav--open', open);
    overlay?.classList.toggle('mobile-overlay--open', open);
    mobileNav?.setAttribute('aria-hidden', String(!open));
    overlay?.setAttribute('aria-hidden', String(!open));
    if (mobileNav) (mobileNav as HTMLElement).inert = !open;
    hamburger?.setAttribute('aria-expanded', String(open));
    hamburger?.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    document.body.style.overflow = open ? 'hidden' : '';
  }

  function openNav() {
    setNavState(true);
    mobileNav?.querySelector<HTMLAnchorElement>('a')?.focus();
  }

  function closeNav() {
    setNavState(false);
    hamburger?.focus();
  }

  if (hamburger && mobileNav) {
    setNavState(false);
    hamburger.addEventListener('click', () => {
      mobileNav.classList.contains('mobile-nav--open') ? closeNav() : openNav();
    });
    overlay?.addEventListener('click', closeNav);
    mobileNav.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setNavState(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && mobileNav.classList.contains('mobile-nav--open')) closeNav();
    });
  }

  document.querySelectorAll<HTMLButtonElement>('.faq__question').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq__item');
      const answer = item?.querySelector('.faq__answer');
      const icon = btn.querySelector('.faq__icon');
      const isOpen = answer?.classList.contains('faq__answer--open');

      document.querySelectorAll('.faq__answer--open').forEach(a => a.classList.remove('faq__answer--open'));
      document.querySelectorAll('.faq__question').forEach(b => b.setAttribute('aria-expanded', 'false'));
      document.querySelectorAll<HTMLElement>('.faq__icon').forEach(i => { i.textContent = '+'; });

      if (!isOpen) {
        answer?.classList.add('faq__answer--open');
        btn.setAttribute('aria-expanded', 'true');
        if (icon) icon.textContent = '\u2212';
      }
    });
  });
</script>
