---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Topbar from "@/components/Topbar.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import WaBubble from "@/components/WaBubble.astro";
import { SITE } from "@/data/site";
import { buildPageMetadata, buildPageSchemas } from "@/lib/seo";

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  schema?: object | object[];
  pageType?: "home" | "page" | "article";
  noindex?: boolean;
  breadcrumbs?: Array<{ name: string; href?: string }>;
}

const {
  title,
  description,
  canonical,
  ogImage,
  schema,
  pageType,
  noindex,
  breadcrumbs,
} = Astro.props;
const metadata = buildPageMetadata({ title, description, canonical, pathname: Astro.url.pathname });
const schemas = buildPageSchemas({ breadcrumbs, schema });
---

<BaseLayout
  title={metadata.title}
  description={metadata.description}
  canonical={metadata.canonical}
  ogImage={ogImage}
  schemas={schemas}
  pageType={pageType}
  noindex={noindex}
>
  <Topbar phone={SITE.tel} whatsapp={SITE.whatsapp} />
  <Header whatsapp={SITE.whatsapp} currentPath={Astro.url.pathname} />

  <slot />

  <Footer phone={SITE.tel} whatsapp={SITE.whatsapp} email={SITE.email} />
  <WaBubble whatsapp={SITE.whatsapp} />
</BaseLayout>
