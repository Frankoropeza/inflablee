---
// FaqItem.astro — Item del acordeón FAQ
export interface Props {
 id:  string;
 question: string;
 // Solo texto plano: evita que este componente genérico se convierta en un sumidero de HTML arbitrario.
 answer:  string;
}

const { id, question, answer } = Astro.props;
---

<details class="faq__item" id={`faq-${id}`}>
 <summary class="faq__question">
 {question}
 <span class="faq__icon" aria-hidden="true">+</span>
 </summary>
 <div class="faq__answer">
 <p>{answer}</p>
 </div>
</details>
