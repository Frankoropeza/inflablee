---
import { getCollection, render } from "astro:content";
interface Props { id: string; accent?: boolean; }
const { id, accent = false } = Astro.props;
const pagina = (await getCollection("paginas")).find((entry) => entry.id === id);
if (!pagina) throw new Error(`Falta el bloque SEO ${id}.`);
const { Content } = await render(pagina);
---

<section style={`padding:var(--spacing-3xl) 0;${accent ? "background:var(--color-accent);" : ""}`}>
  <div class="container section__seo markdown-seo"><Content /></div>
</section>

<style>.markdown-seo :global(p){color:var(--color-text-light);line-height:1.7}.markdown-seo :global(h2){color:var(--color-secondary);font-size:var(--font-size-xl);margin:1rem 0}.markdown-seo :global(h2 + p){margin-bottom:2rem}.markdown-seo :global(p:not(:has(+ h2))){font-size:var(--font-size-xs);font-weight:700;letter-spacing:.06em}</style>
