---
export interface Props {
  name: string;
  text: string;
  event: string;
  stars?: number;
  initials?: string;
}

const { name, text, event, stars = 5, initials } = Astro.props;
const initial = initials ?? name.charAt(0).toUpperCase();
const starStr = "⭐".repeat(stars);
---

<div class="testimonial-card">
  <div class="testimonial-card__stars">{starStr}</div>
  <p class="testimonial-card__text">"{text}"</p>
  <div class="testimonial-card__author">
    <div class="testimonial-card__avatar">{initial}</div>
    <div>
      <p class="testimonial-card__name">{name}</p>
      <p class="testimonial-card__event">{event}</p>
    </div>
  </div>
</div>

<style>
.testimonial-card {
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: var(--border-radius-lg);
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 1rem;
  border-left: 4px solid var(--color-primary);
}
.testimonial-card__stars {
  font-size: 1rem;
  letter-spacing: 2px;
}
.testimonial-card__text {
  font-style: italic;
  color: rgba(255,255,255,0.88);
  font-size: var(--font-size-sm);
  line-height: 1.75;
  flex: 1;
  margin: 0;
}
.testimonial-card__author {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}
.testimonial-card__avatar {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-weight: 800;
  font-size: var(--font-size-base);
  flex-shrink: 0;
}
.testimonial-card__name {
  font-weight: 700;
  color: #fff;
  font-size: var(--font-size-sm);
  margin: 0;
}
.testimonial-card__event {
  font-size: var(--font-size-xs);
  color: var(--color-primary);
  margin: 0;
}
</style>
