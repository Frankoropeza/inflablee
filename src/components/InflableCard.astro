---
export interface Props {
  title: string;
  descripcion: string;
  categoria: string;
  precio_desde: number;
  capacidad: string;
  medidas: string;
  tiempo_instalacion: string;
  slug: string;
  disponible?: boolean;
  featured?: boolean;
  gradient?: string;
}

const {
  title,
  descripcion,
  categoria,
  precio_desde,
  capacidad,
  medidas,
  tiempo_instalacion,
  slug,
  disponible = true,
  featured = false,
  gradient = "linear-gradient(135deg, #FF4B1F22 0%, #1A1A2E11 100%)",
} = Astro.props;

import { SITE } from "@/data/site";

const categoriaEmojis: Record<string, string> = {
  "castillos-inflables": "🏰",
  "toboganes-acuaticos": "🌊",
  "pistas-obstaculos": "🏃",
  "juegos-interactivos": "🥊",
  "inflables-gigantes": "🎪",
};

const emoji = categoriaEmojis[categoria] ?? "🎈";
const waText = encodeURIComponent(`Hola INFLABLEE, me interesa rentar: ${title}. ¿Cuál es el precio?`);
---

<div class={`inflable-card${featured ? " inflable-card--featured" : ""}${!disponible ? " inflable-card--agotado" : ""}`}>
  <div class="inflable-card__img" style={`background: ${gradient};`}>
    <span class="inflable-card__emoji">{emoji}</span>
    {featured && <span class="inflable-card__badge inflable-card__badge--featured">⭐ Más popular</span>}
    {!disponible && <span class="inflable-card__badge inflable-card__badge--agotado">No disponible</span>}
  </div>
  <div class="inflable-card__body">
    <h3 class="inflable-card__title">{title}</h3>
    <p class="inflable-card__desc">{descripcion}</p>

    <div class="inflable-card__specs">
      <div class="inflable-card__spec">
        <span class="inflable-card__spec-label">👥 Capacidad</span>
        <span class="inflable-card__spec-value">{capacidad}</span>
      </div>
      <div class="inflable-card__spec">
        <span class="inflable-card__spec-label">📐 Medidas</span>
        <span class="inflable-card__spec-value">{medidas}</span>
      </div>
      <div class="inflable-card__spec">
        <span class="inflable-card__spec-label">⏱️ Instalación</span>
        <span class="inflable-card__spec-value">{tiempo_instalacion}</span>
      </div>
      <div class="inflable-card__spec inflable-card__spec--price">
        <span class="inflable-card__spec-label">💰 Desde</span>
        <span class="inflable-card__spec-value inflable-card__price">${precio_desde.toLocaleString()} MXN</span>
      </div>
    </div>

    <div class="inflable-card__actions">
      <a
        href={`https://wa.me/${SITE.whatsapp}?text=${waText}`}
        class="inflable-card__btn-primary"
        target="_blank"
        rel="noopener"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        Cotizar por WhatsApp
      </a>
      <a href={`/inflables/${slug}`} class="inflable-card__btn-secondary">Ver detalles</a>
    </div>
  </div>
</div>

<style>
.inflable-card {
  background: var(--color-white);
  border: 1.5px solid var(--color-border);
  border-radius: var(--border-radius-lg);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: transform var(--transition-base), box-shadow var(--transition-base), border-color var(--transition-base);
}
.inflable-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-lg);
}
.inflable-card--featured {
  border-color: var(--color-primary);
  box-shadow: 0 0 0 2px rgba(255,75,31,0.15);
}
.inflable-card--agotado { opacity: 0.65; }

.inflable-card__img {
  position: relative;
  width: 100%;
  aspect-ratio: 16/10;
  display: flex;
  align-items: center;
  justify-content: center;
}
.inflable-card__emoji {
  font-size: 4.5rem;
  filter: drop-shadow(0 4px 12px rgba(0,0,0,0.15));
}
.inflable-card__badge {
  position: absolute;
  top: 0.75rem;
  left: 0.75rem;
  font-size: 0.68rem;
  font-weight: 700;
  padding: 0.3rem 0.75rem;
  border-radius: 50px;
}
.inflable-card__badge--featured { background: var(--color-primary); color: #fff; }
.inflable-card__badge--agotado  { background: #6B7280; color: #fff; }

.inflable-card__body {
  padding: 1.25rem;
  display: flex;
  flex-direction: column;
  gap: 0.875rem;
  flex: 1;
}
.inflable-card__title {
  font-size: var(--font-size-lg);
  font-weight: 800;
  color: var(--color-secondary);
  line-height: 1.2;
  margin: 0;
}
.inflable-card__desc {
  font-size: var(--font-size-sm);
  color: var(--color-text-light);
  line-height: 1.6;
  margin: 0;
  flex: 1;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.inflable-card__specs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.5rem;
  background: var(--color-accent);
  border-radius: var(--border-radius);
  padding: 0.875rem;
}
.inflable-card__spec {
  display: flex;
  flex-direction: column;
  gap: 0.15rem;
}
.inflable-card__spec-label {
  font-size: 0.68rem;
  color: var(--color-text-light);
}
.inflable-card__spec-value {
  font-size: var(--font-size-sm);
  font-weight: 700;
  color: var(--color-secondary);
}
.inflable-card__price {
  color: var(--color-primary) !important;
  font-size: var(--font-size-base) !important;
}

.inflable-card__actions {
  display: flex;
  gap: 0.625rem;
  margin-top: auto;
}
.inflable-card__btn-primary {
  flex: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.4rem;
  padding: 0.75rem 1rem;
  background: #25D366;
  color: #fff;
  border-radius: var(--border-radius);
  font-size: var(--font-size-xs);
  font-weight: 700;
  text-decoration: none;
  transition: background var(--transition-fast), transform var(--transition-fast);
  white-space: nowrap;
}
.inflable-card__btn-primary:hover {
  background: #1da851;
  transform: translateY(-1px);
}
.inflable-card__btn-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.75rem 1rem;
  border: 1.5px solid var(--color-border);
  color: var(--color-secondary);
  border-radius: var(--border-radius);
  font-size: var(--font-size-xs);
  font-weight: 700;
  text-decoration: none;
  transition: all var(--transition-fast);
  white-space: nowrap;
}
.inflable-card__btn-secondary:hover {
  border-color: var(--color-primary);
  color: var(--color-primary);
}
</style>
