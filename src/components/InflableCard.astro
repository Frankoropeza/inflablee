---
export interface Props {
  title: string;
  descripcion: string;
  categoria: string;
  precio_desde: number;
  capacidad: string;
  medidas: string;
  tiempo_instalacion: string;
  slug: string;
  imagen?: string;
  disponible?: boolean;
  featured?: boolean;
}

const {
  title,
  descripcion,
  categoria,
  precio_desde,
  capacidad,
  medidas,
  tiempo_instalacion,
  slug,
  imagen,
  disponible = true,
  featured = false,
} = Astro.props;

import { SITE } from "@/data/site";

const categoriaBadgeMap: Record<string, { label: string; color: string }> = {
  "castillos":  { label: "Castillo", color: "#FF4B1F" },
  "toboganes":  { label: "Tobogán", color: "#0077CC" },
  "pistas":     { label: "Pista", color: "#7C3AED" },
  "interactivos": { label: "Interactivo", color: "#D97706" },
};
const badge = categoriaBadgeMap[categoria] ?? { label: categoria, color: "#6B7280" };
const waText = encodeURIComponent(`Hola INFLABLEE, me interesa rentar: ${title}. ¿Cuál es el precio y disponibilidad?`);
---

<div class={`inflable-card${featured ? " inflable-card--featured" : ""}${!disponible ? " inflable-card--agotado" : ""}`}>
  <div class="inflable-card__img-wrap">
    {imagen ? (
      <img
        src={imagen}
        alt={`Renta de ${title} en CDMX`}
        width="400"
        height="267"
        loading="lazy"
        class="inflable-card__img"
      />
    ) : (
      <div class="inflable-card__img-placeholder">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      </div>
    )}
    <div class="inflable-card__badges">
      <span class="inflable-card__cat-badge" style={`background:${badge.color};`}>{badge.label}</span>
      {featured && <span class="inflable-card__featured-badge">Más popular</span>}
      {!disponible && <span class="inflable-card__unavail-badge">No disponible</span>}
    </div>
  </div>

  <div class="inflable-card__body">
    <h3 class="inflable-card__title">{title}</h3>
    <p class="inflable-card__desc">{descripcion}</p>

    <div class="inflable-card__price-row">
      <span class="inflable-card__price-label">Desde</span>
      <span class="inflable-card__price">${precio_desde.toLocaleString()} <small>MXN</small></span>
    </div>

    <div class="inflable-card__specs">
      <div class="inflable-card__spec">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
        <span>{capacidad}</span>
      </div>
      <div class="inflable-card__spec">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 3H3v18h18V3z"/><path d="M9 3v18M15 3v18M3 9h18M3 15h18"/></svg>
        <span>{medidas}</span>
      </div>
      <div class="inflable-card__spec">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <span>{tiempo_instalacion}</span>
      </div>
    </div>

    <div class="inflable-card__actions">
      <a
        href={`https://wa.me/${SITE.whatsapp}?text=${waText}`}
        class="inflable-card__btn-wa"
        target="_blank"
        rel="noopener"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        Cotizar
      </a>
      <a href={`/inflables/${slug}`} class="inflable-card__btn-detail">Ver detalles</a>
    </div>
  </div>
</div>

<style>
.inflable-card {
  background: var(--color-white);
  border: 1.5px solid var(--color-border);
  border-radius: var(--border-radius-lg);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: transform var(--transition-fast), box-shadow var(--transition-fast), border-color var(--transition-fast);
}
.inflable-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-lg);
}
.inflable-card--featured {
  border-color: var(--color-primary);
  box-shadow: 0 0 0 2px rgba(255,75,31,0.12);
}
.inflable-card--agotado { opacity: 0.65; }

.inflable-card__img-wrap {
  position: relative;
  width: 100%;
  aspect-ratio: 3/2;
  overflow: hidden;
  background: var(--color-accent);
}
.inflable-card__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.4s ease;
}
.inflable-card:hover .inflable-card__img {
  transform: scale(1.04);
}
.inflable-card__img-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-light);
}
.inflable-card__badges {
  position: absolute;
  top: 0.75rem;
  left: 0.75rem;
  display: flex;
  flex-wrap: wrap;
  gap: 0.35rem;
}
.inflable-card__cat-badge {
  font-size: 0.65rem;
  font-weight: 700;
  color: #fff;
  padding: 0.25rem 0.6rem;
  border-radius: var(--border-radius-full, 9999px);
  text-transform: uppercase;
  letter-spacing: 0.04em;
}
.inflable-card__featured-badge {
  font-size: 0.65rem;
  font-weight: 700;
  background: var(--color-accent-gold, #FFD700);
  color: #1A1A2E;
  padding: 0.25rem 0.6rem;
  border-radius: var(--border-radius-full, 9999px);
  letter-spacing: 0.02em;
}
.inflable-card__unavail-badge {
  font-size: 0.65rem;
  font-weight: 700;
  background: #6B7280;
  color: #fff;
  padding: 0.25rem 0.6rem;
  border-radius: var(--border-radius-full, 9999px);
}

.inflable-card__body {
  padding: 1.25rem;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  flex: 1;
}
.inflable-card__title {
  font-size: var(--font-size-lg);
  font-weight: 800;
  color: var(--color-secondary);
  line-height: 1.2;
  margin: 0;
}
.inflable-card__desc {
  font-size: var(--font-size-sm);
  color: var(--color-text-light);
  line-height: 1.6;
  margin: 0;
  flex: 1;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.inflable-card__price-row {
  display: flex;
  align-items: baseline;
  gap: 0.4rem;
}
.inflable-card__price-label {
  font-size: var(--font-size-xs);
  color: var(--color-text-light);
  font-weight: 500;
}
.inflable-card__price {
  font-size: var(--font-size-xl);
  font-weight: 900;
  color: var(--color-primary);
  line-height: 1;
}
.inflable-card__price small {
  font-size: var(--font-size-sm);
  font-weight: 600;
}

.inflable-card__specs {
  display: flex;
  gap: 0.75rem;
  flex-wrap: wrap;
  padding: 0.75rem;
  background: var(--color-accent);
  border-radius: var(--border-radius);
}
.inflable-card__spec {
  display: flex;
  align-items: center;
  gap: 0.3rem;
  font-size: var(--font-size-xs);
  color: var(--color-text-light);
  font-weight: 500;
}
.inflable-card__spec svg {
  color: var(--color-primary);
  flex-shrink: 0;
}

.inflable-card__actions {
  display: flex;
  gap: 0.625rem;
  margin-top: auto;
}
.inflable-card__btn-wa {
  flex: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.4rem;
  padding: 0.75rem 1rem;
  background: #25D366;
  color: #fff;
  border-radius: var(--border-radius);
  font-size: var(--font-size-sm);
  font-weight: 700;
  text-decoration: none;
  transition: background var(--transition-fast), transform var(--transition-fast);
}
.inflable-card__btn-wa:hover {
  background: #1da851;
  transform: translateY(-1px);
}
.inflable-card__btn-detail {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.75rem 1rem;
  border: 1.5px solid var(--color-border);
  color: var(--color-secondary);
  border-radius: var(--border-radius);
  font-size: var(--font-size-sm);
  font-weight: 700;
  text-decoration: none;
  transition: all var(--transition-fast);
  white-space: nowrap;
}
.inflable-card__btn-detail:hover {
  border-color: var(--color-primary);
  color: var(--color-primary);
}
</style>
