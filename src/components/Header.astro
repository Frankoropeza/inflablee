---
export interface Props {
  whatsapp?: string;
  currentPath?: string;
}

const {
  whatsapp = "521XXXXXXXXXX",
  currentPath = Astro.url.pathname,
} = Astro.props;

const isActive = (path: string) =>
  currentPath === path ? "nav-desktop__link--active" : "";
const isSection = (prefix: string) =>
  currentPath.startsWith(prefix) ? "nav-desktop__link--active" : "";
---

<a href="#contenido-principal" class="skip-link">Saltar al contenido principal</a>

<header class="header" id="header" role="banner">
  <div class="container">
    <a href="/" class="header__logo" aria-label="INFLABLEE — Renta de Inflables — Inicio">
      <span class="header__logo-text">INFLABLEE</span>
    </a>

    <nav class="nav-desktop" role="navigation" aria-label="Navegación principal">
      <ul class="nav-desktop__list">
        <li class="nav-desktop__item">
          <a href="/" class={`nav-desktop__link ${isActive("/")}`}>Inicio</a>
        </li>
        <li class="nav-desktop__item">
          <a href="/servicios" class={`nav-desktop__link ${isSection("/servicios")}`}>Inflables</a>
        </li>
        <li class="nav-desktop__item">
          <a href="/servicios#paquetes" class={`nav-desktop__link`}>Paquetes</a>
        </li>
        <li class="nav-desktop__item">
          <a href="/#galeria" class={`nav-desktop__link`}>Galería</a>
        </li>
        <li class="nav-desktop__item">
          <a href="/blog" class={`nav-desktop__link ${isSection("/blog")}`}>Blog</a>
        </li>
        <li class="nav-desktop__item">
          <a href="/contacto" class={`nav-desktop__link ${isActive("/contacto/")}`}>Contacto</a>
        </li>
      </ul>
    </nav>

    <a href={`https://wa.me/${whatsapp}?text=${encodeURIComponent("Hola INFLABLEE, quiero cotizar inflables para mi evento.")}`}
      class="btn btn--primary btn--sm header__cta"
      target="_blank" rel="noopener"
      aria-label="Cotizar evento por WhatsApp">
      Cotiza tu evento
    </a>

    <button class="hamburger" id="hamburger"
      aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-nav">
      <span class="hamburger__line"></span>
      <span class="hamburger__line"></span>
      <span class="hamburger__line"></span>
    </button>
  </div>
</header>

<div class="mobile-overlay" id="mobile-overlay" aria-hidden="true"></div>
<nav class="mobile-nav" id="mobile-nav"
  role="navigation" aria-label="Navegación móvil" aria-hidden="true">
  <ul>
    <li class="mobile-nav__item"><a href="/" class="mobile-nav__link">Inicio</a></li>
    <li class="mobile-nav__item"><a href="/servicios" class="mobile-nav__link">Inflables</a></li>
    <li class="mobile-nav__item"><a href="/servicios#paquetes" class="mobile-nav__link">Paquetes</a></li>
    <li class="mobile-nav__item"><a href="/#galeria" class="mobile-nav__link">Galería</a></li>
    <li class="mobile-nav__item"><a href="/blog" class="mobile-nav__link">Blog</a></li>
    <li class="mobile-nav__item"><a href="/nosotros" class="mobile-nav__link">Nosotros</a></li>
    <li class="mobile-nav__item"><a href="/contacto" class="mobile-nav__link">Contacto</a></li>
  </ul>
  <div class="mobile-nav__cta">
    <a href={`https://wa.me/${whatsapp}?text=${encodeURIComponent("Hola INFLABLEE, quiero cotizar inflables para mi evento.")}`}
      class="btn btn--primary" target="_blank" rel="noopener">
      Cotiza tu evento
    </a>
  </div>
</nav>
