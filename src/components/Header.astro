---
import { SITE } from "@/data/site";
import { CATEGORIAS } from "@/data/categorias";
import { ALCALDIAS_DESTACADAS, MUNICIPIOS_DESTACADOS } from "@/data/zonas";

export interface Props {
  whatsapp?: string;
  currentPath?: string;
}

const {
  whatsapp = SITE.whatsapp,
  currentPath = Astro.url.pathname,
} = Astro.props;

const matchesPath = (path: string) =>
  path === "/" ? currentPath === "/" : currentPath === path || currentPath === `${path}/`;
const isActive = (path: string) =>
  matchesPath(path) ? "nav-desktop__link--active" : "";
const isSection = (prefix: string) =>
  currentPath.startsWith(prefix) ? "nav-desktop__link--active" : "";
const isSectionCurrent = (prefix: string) => currentPath.startsWith(prefix);
---

<a href="#contenido-principal" class="skip-link">Saltar al contenido principal</a>

<header class="header" id="header" role="banner">
  <div class="container">
    <a href="/" class="header__logo" aria-label="INFLABLEE — Renta de Inflables — Inicio">
      <span class="header__logo-text">INFLABLEE</span>
    </a>

    <nav class="nav-desktop" role="navigation" aria-label="Navegación principal">
      <ul class="nav-desktop__list">
        <li class="nav-desktop__item">
          <a href="/" class={`nav-desktop__link ${isActive("/")}`} aria-current={matchesPath("/") ? "page" : undefined}>Inicio</a>
        </li>
        <li class="nav-desktop__item">
          <a href="/inflables" class={`nav-desktop__link ${isSection("/inflables")}`} aria-current={isSectionCurrent("/inflables") ? "page" : undefined}>Inflables</a>
          <div class="mega-menu">
            <div class="mega-menu__category">
              <p class="mega-menu__title">Por categoría</p>
              <ul class="mega-menu__list">
                {CATEGORIAS.map(c => (
                  <li><a href={`/inflables/${c.slug}`} class="mega-menu__link">{c.emoji} {c.label}</a></li>
                ))}
                <li><a href="/inflables/inflables-gigantes" class="mega-menu__link">🎪 Inflables gigantes</a></li>
              </ul>
              <a href="/inflables" class="mega-menu__view-all">Ver catálogo completo &rarr;</a>
            </div>
            <div class="mega-menu__category">
              <p class="mega-menu__title">Por tipo de evento</p>
              <ul class="mega-menu__list">
                <li><a href="/servicios/fiestas-infantiles" class="mega-menu__link">Fiestas infantiles</a></li>
                <li><a href="/servicios/eventos-escolares" class="mega-menu__link">Eventos escolares</a></li>
                <li><a href="/servicios/eventos-corporativos" class="mega-menu__link">Eventos corporativos</a></li>
                <li><a href="/servicios/paquetes" class="mega-menu__link">Paquetes</a></li>
              </ul>
              <a href="/servicios" class="mega-menu__view-all">Todos los servicios &rarr;</a>
            </div>
            <div class="mega-menu__category mega-menu__category--cta">
              <p class="mega-menu__title">¿No sabes cuál elegir?</p>
              <p class="mega-menu__desc">Dinos el espacio que tienes y la edad de los niños; te decimos cuál cabe y cuánto cuesta.</p>
              <a href="/cotizar" class="btn btn--primary btn--sm">Cotizar mi evento</a>
              <a href={`https://wa.me/${whatsapp}`} class="mega-menu__whatsapp" target="_blank" rel="noopener">o escríbenos por WhatsApp</a>
            </div>
          </div>
        </li>
        <li class="nav-desktop__item">
          <a href="/servicios/paquetes" class={`nav-desktop__link ${isActive("/servicios/paquetes")}`} aria-current={matchesPath("/servicios/paquetes") ? "page" : undefined}>Paquetes</a>
        </li>
        <li class="nav-desktop__item">
          <a href="/zonas" class={`nav-desktop__link ${isSection("/zonas")}`} aria-current={isSectionCurrent("/zonas") ? "page" : undefined}>Zonas</a>
          <div class="mega-menu">
            <div class="mega-menu__category">
              <p class="mega-menu__title">Ciudad de México</p>
              <ul class="mega-menu__list">
                {ALCALDIAS_DESTACADAS.map(a => (
                  <li><a href="/zonas/cdmx" class="mega-menu__link">{a}</a></li>
                ))}
              </ul>
              <a href="/zonas/cdmx" class="mega-menu__view-all">Ver cobertura en CDMX &rarr;</a>
            </div>
            <div class="mega-menu__category">
              <p class="mega-menu__title">Estado de México</p>
              <ul class="mega-menu__list">
                {MUNICIPIOS_DESTACADOS.map(m => (
                  <li><a href="/zonas/estado-de-mexico" class="mega-menu__link">{m}</a></li>
                ))}
              </ul>
              <a href="/zonas/estado-de-mexico" class="mega-menu__view-all">Ver municipios &rarr;</a>
            </div>
            <div class="mega-menu__category mega-menu__category--cta">
              <p class="mega-menu__title">¿Entregamos en tu zona?</p>
              <p class="mega-menu__desc">Consulta el costo de envío por zona antes de reservar.</p>
              <a href="/zonas" class="btn btn--outline btn--sm">Ver cobertura</a>
            </div>
          </div>
        </li>
        <li class="nav-desktop__item">
          <a href="/galeria" class={`nav-desktop__link ${isActive("/galeria")}`} aria-current={matchesPath("/galeria") ? "page" : undefined}>Galería</a>
        </li>
        <li class="nav-desktop__item">
          <a href="/blog" class={`nav-desktop__link ${isSection("/blog")}`} aria-current={isSectionCurrent("/blog") ? "page" : undefined}>Blog</a>
        </li>
        <li class="nav-desktop__item">
          <a href="/contacto" class={`nav-desktop__link ${isActive("/contacto")}`} aria-current={matchesPath("/contacto") ? "page" : undefined}>Contacto</a>
        </li>
      </ul>
    </nav>

    <a href={`https://wa.me/${whatsapp}?text=${encodeURIComponent("Hola INFLABLEE, quiero cotizar inflables para mi evento.")}`}
      class="btn btn--primary btn--sm header__cta"
      target="_blank" rel="noopener"
      aria-label="Cotizar evento por WhatsApp">
      Cotiza tu evento
    </a>

    <button class="hamburger" id="hamburger"
      aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-nav">
      <span class="hamburger__line"></span>
      <span class="hamburger__line"></span>
      <span class="hamburger__line"></span>
    </button>
  </div>
</header>

<div class="mobile-overlay" id="mobile-overlay" aria-hidden="true"></div>
<nav class="mobile-nav" id="mobile-nav"
  role="navigation" aria-label="Navegación móvil" aria-hidden="true">
  <ul>
    <li class="mobile-nav__item"><a href="/" class="mobile-nav__link" aria-current={matchesPath("/") ? "page" : undefined}>Inicio</a></li>
    <li class="mobile-nav__item"><a href="/inflables" class="mobile-nav__link" aria-current={isSectionCurrent("/inflables") ? "page" : undefined}>Inflables</a></li>
    <li class="mobile-nav__item"><a href="/servicios/paquetes" class="mobile-nav__link" aria-current={matchesPath("/servicios/paquetes") ? "page" : undefined}>Paquetes</a></li>
    <li class="mobile-nav__item"><a href="/zonas" class="mobile-nav__link" aria-current={isSectionCurrent("/zonas") ? "page" : undefined}>Zonas de entrega</a></li>
    <li class="mobile-nav__item"><a href="/galeria" class="mobile-nav__link" aria-current={matchesPath("/galeria") ? "page" : undefined}>Galería</a></li>
    <li class="mobile-nav__item"><a href="/precios" class="mobile-nav__link" aria-current={matchesPath("/precios") ? "page" : undefined}>Precios</a></li>
    <li class="mobile-nav__item"><a href="/preguntas-frecuentes" class="mobile-nav__link" aria-current={matchesPath("/preguntas-frecuentes") ? "page" : undefined}>Preguntas frecuentes</a></li>
    <li class="mobile-nav__item"><a href="/blog" class="mobile-nav__link" aria-current={isSectionCurrent("/blog") ? "page" : undefined}>Blog</a></li>
    <li class="mobile-nav__item"><a href="/nosotros" class="mobile-nav__link" aria-current={matchesPath("/nosotros") ? "page" : undefined}>Nosotros</a></li>
    <li class="mobile-nav__item"><a href="/contacto" class="mobile-nav__link" aria-current={matchesPath("/contacto") ? "page" : undefined}>Contacto</a></li>
  </ul>
  <div class="mobile-nav__cta">
    <a href={`https://wa.me/${whatsapp}?text=${encodeURIComponent("Hola INFLABLEE, quiero cotizar inflables para mi evento.")}`}
      class="btn btn--primary" target="_blank" rel="noopener">
      Cotiza tu evento
    </a>
    <a href={`tel:${SITE.telHref}`} class="btn btn--outline" aria-label={`Llamar al ${SITE.tel}`}>
      Llamar {SITE.tel}
    </a>
  </div>
</nav>

<script>
  const hamburger = document.getElementById("hamburger");
  const mobileNav = document.getElementById("mobile-nav");
  const overlay = document.getElementById("mobile-overlay");

  function setNavState(open: boolean) {
    mobileNav?.classList.toggle("mobile-nav--open", open);
    overlay?.classList.toggle("mobile-overlay--open", open);
    mobileNav?.setAttribute("aria-hidden", String(!open));
    overlay?.setAttribute("aria-hidden", String(!open));
    if (mobileNav) (mobileNav as HTMLElement).inert = !open;
    hamburger?.setAttribute("aria-expanded", String(open));
    hamburger?.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
    document.body.style.overflow = open ? "hidden" : "";
  }

  function closeNav() {
    setNavState(false);
    hamburger?.focus();
  }

  if (hamburger && mobileNav) {
    setNavState(false);
    hamburger.addEventListener("click", () => {
      mobileNav.classList.contains("mobile-nav--open") ? closeNav() : setNavState(true);
    });
    overlay?.addEventListener("click", closeNav);
    mobileNav.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("a")) setNavState(false);
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && mobileNav.classList.contains("mobile-nav--open")) closeNav();
    });
  }
</script>
