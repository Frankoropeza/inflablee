---
export interface Props {
  title?: string;
  subtitle?: string;
  primaryText?: string;
  primaryHref?: string;
  secondaryText?: string;
  secondaryHref?: string;
  eyebrow?: string;
}

import { SITE } from "@/data/site";

const {
  title = "¿Listo para hacer tu fiesta increíble?",
  subtitle = "Reserva hoy con disponibilidad garantizada. Entrega e instalación incluida en CDMX y Estado de México.",
  primaryText = "Cotizar por WhatsApp",
  primaryHref = `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent("Hola INFLABLEE, quiero reservar un inflable para mi evento.")}`,
  secondaryText = "Ver catálogo completo",
  secondaryHref = "/inflables",
  eyebrow = "🎉 Reserva tu fecha hoy",
} = Astro.props;
---

<section class="cta-banner">
  <div class="cta-banner__bg"></div>
  <div class="container">
    <div class="cta-banner__inner">
      <div class="cta-banner__content">
        {eyebrow && <span class="cta-banner__eyebrow">{eyebrow}</span>}
        <h2 class="cta-banner__title">{title}</h2>
        <p class="cta-banner__subtitle">{subtitle}</p>
        <div class="cta-banner__badges">
          <span class="cta-banner__badge">✅ Sin pagos ocultos</span>
          <span class="cta-banner__badge">✅ Supervisión incluida</span>
          <span class="cta-banner__badge">✅ Seguro de responsabilidad civil</span>
        </div>
      </div>
      <div class="cta-banner__actions">
        <a href={primaryHref} class="cta-banner__btn-primary" target="_blank" rel="noopener">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          {primaryText}
        </a>
        <a href={secondaryHref} class="cta-banner__btn-secondary">
          {secondaryText} →
        </a>
      </div>
    </div>
  </div>
</section>

<style>
.cta-banner {
  position: relative;
  padding: var(--spacing-4xl) 0;
  background: linear-gradient(135deg, var(--color-secondary) 0%, #2D3748 100%);
  overflow: hidden;
}
.cta-banner__bg {
  position: absolute;
  inset: 0;
  background-image: radial-gradient(ellipse 60% 80% at 80% 50%, rgba(255,75,31,0.2) 0%, transparent 60%);
  pointer-events: none;
}
.cta-banner__inner {
  position: relative;
  display: grid;
  grid-template-columns: 1fr;
  gap: 2rem;
  align-items: center;
}
@media (min-width: 1024px) {
  .cta-banner__inner { grid-template-columns: 1fr auto; gap: 3rem; }
}
.cta-banner__eyebrow {
  display: inline-block;
  font-size: var(--font-size-sm);
  font-weight: 700;
  color: var(--color-primary);
  margin-bottom: 0.75rem;
}
.cta-banner__title {
  font-size: clamp(1.75rem, 3.5vw, 2.75rem);
  font-weight: 800;
  color: #fff;
  line-height: 1.15;
  margin: 0 0 0.875rem;
}
.cta-banner__subtitle {
  font-size: var(--font-size-lg);
  color: rgba(255,255,255,0.75);
  line-height: 1.6;
  margin: 0 0 1.5rem;
  max-width: 580px;
}
.cta-banner__badges {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
}
.cta-banner__badge {
  font-size: var(--font-size-sm);
  color: rgba(255,255,255,0.8);
}
.cta-banner__actions {
  display: flex;
  flex-direction: column;
  gap: 0.875rem;
  flex-shrink: 0;
}
.cta-banner__btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 1rem 2rem;
  background: #25D366;
  color: #fff;
  border-radius: var(--border-radius);
  font-size: var(--font-size-base);
  font-weight: 700;
  text-decoration: none;
  white-space: nowrap;
  transition: background var(--transition-fast), transform var(--transition-fast);
  box-shadow: 0 4px 20px rgba(37,211,102,0.4);
}
.cta-banner__btn-primary:hover {
  background: #1da851;
  transform: translateY(-2px);
}
.cta-banner__btn-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 1rem 2rem;
  border: 2px solid rgba(255,255,255,0.35);
  color: #fff;
  border-radius: var(--border-radius);
  font-size: var(--font-size-base);
  font-weight: 700;
  text-decoration: none;
  white-space: nowrap;
  transition: all var(--transition-fast);
}
.cta-banner__btn-secondary:hover {
  background: rgba(255,255,255,0.1);
  border-color: rgba(255,255,255,0.6);
}
</style>
