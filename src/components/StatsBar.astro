---
export interface Stat {
  value: string;
  label: string;
  icon?: string;
}

export interface Props {
  stats?: Stat[];
  bgColor?: string;
}

const { 
  stats = [
    { value: "500+", label: "Eventos realizados", icon: "🎉" },
    { value: "15+", label: "Tipos de inflables", icon: "🎪" },
    { value: "24/7", label: "Atención al cliente", icon: "📲" },
    { value: "CDMX+Edomex", label: "Zonas de cobertura", icon: "📍" },
  ],
  bgColor = "var(--color-primary)"
} = Astro.props;
---

<section class="stats-bar" style={`background: ${bgColor};`}>
  <div class="container">
    <div class="stats-bar__grid">
      {stats.map((stat) => (
        <div class="stats-bar__item">
          {stat.icon && <span class="stats-bar__icon">{stat.icon}</span>}
          <span class="stats-bar__value">{stat.value}</span>
          <span class="stats-bar__label">{stat.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
.stats-bar {
  padding: 2rem 0;
}
.stats-bar__grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.5rem;
  text-align: center;
}
@media (min-width: 640px) {
  .stats-bar__grid { grid-template-columns: repeat(4, 1fr); }
}
.stats-bar__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.25rem;
}
.stats-bar__icon {
  font-size: 1.75rem;
  margin-bottom: 0.25rem;
}
.stats-bar__value {
  font-size: clamp(1.5rem, 3vw, 2rem);
  font-weight: 800;
  color: #fff;
  line-height: 1;
}
.stats-bar__label {
  font-size: 0.78rem;
  color: rgba(255,255,255,0.8);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}
</style>
